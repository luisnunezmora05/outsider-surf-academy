---
import { ROUTES } from '../../lib/seo'

interface Props {
  /** Overlay the nav transparently on top of a dark hero (turns solid on scroll). */
  transparent?: boolean
}
const { transparent = false } = Astro.props

interface NavChild { label: string; href: string }
interface NavItem { label: string; href: string; children?: NavChild[] }

const navItems: NavItem[] = [
  {
    label: 'Surf Lessons',
    href: ROUTES.SURF_LESSONS,
    children: [
      { label: 'Private Lessons', href: ROUTES.PRIVATE },
      { label: 'Semi-Private Lessons', href: ROUTES.SEMI_PRIVATE },
      { label: 'Group Lessons', href: ROUTES.GROUP },
    ],
  },
  { label: 'Rentals', href: ROUTES.RENTALS },
  { label: 'About Us', href: ROUTES.ABOUT },
  { label: 'Blog', href: ROUTES.BLOG },
  { label: 'Contact', href: ROUTES.CONTACT },
]
---

<header id="siteNav" class:list={['site-nav', transparent ? 'is-transparent' : 'is-solid']}>
  <nav class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Outsider Surf Academy — home">
      <span class="nav-mark">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c2-4 6-7 10-7s8 3 10 7"/><path d="M2 16c2-4 6-7 10-7s8 3 10 7"/></svg>
      </span>
      <span class="nav-brand">Outsider<span class="nav-brand-sub">Surf Academy</span></span>
    </a>

    <ul class="nav-links">
      {navItems.map(item => item.children ? (
        <li class="nav-group">
          <a href={item.href} class="nav-link nav-parent">
            {item.label}
            <svg class="caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <ul class="nav-dropdown">
            {item.children.map(c => (
              <li><a href={c.href}>{c.label}</a></li>
            ))}
          </ul>
        </li>
      ) : (
        <li><a href={item.href} class="nav-link">{item.label}</a></li>
      ))}
    </ul>

    <a href={ROUTES.BOOK} class="nav-book">Book a Lesson</a>

    <button id="burger" class="nav-burger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <ul id="mobileMenu" class="nav-mobile" hidden>
    {navItems.map(item => item.children ? (
      <li class="m-group">
        <button class="m-parent" aria-expanded="false">
          {item.label}
          <span class="m-caret" aria-hidden="true">+</span>
        </button>
        <ul class="m-sub">
          {item.children.map(c => (
            <li><a href={c.href}>{c.label}</a></li>
          ))}
        </ul>
      </li>
    ) : (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
    <li><a href={ROUTES.BOOK} class="btn btn-sun w-full text-center">Book a Lesson</a></li>
  </ul>
</header>

<style>
  .site-nav {
    z-index: 50; height: 74px; display: flex; align-items: center;
    transition: background .35s cubic-bezier(.22,.61,.36,1), box-shadow .35s, border-color .35s;
    border-bottom: 1px solid transparent;
  }
  .site-nav.is-solid {
    position: sticky; top: 0;
    background: rgba(247,242,234,.9);
    -webkit-backdrop-filter: saturate(140%) blur(14px); backdrop-filter: saturate(140%) blur(14px);
    border-bottom-color: rgba(6,50,46,.12);
  }
  .site-nav.is-transparent { position: fixed; top: 0; left: 0; right: 0; background: transparent; }
  .site-nav.is-transparent.scrolled {
    background: rgba(247,242,234,.9);
    -webkit-backdrop-filter: saturate(140%) blur(14px); backdrop-filter: saturate(140%) blur(14px);
    border-bottom-color: rgba(6,50,46,.12);
  }

  .nav-inner {
    max-width: 1180px; width: 100%; margin: 0 auto; padding: 0 1.5rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }

  .nav-logo { display: inline-flex; align-items: center; gap: .6rem; }
  .nav-mark {
    width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
    background: var(--teal); color: #fff;
    display: flex; align-items: center; justify-content: center;
  }
  .nav-brand {
    font-family: var(--font-display); font-size: 1.3rem; font-weight: 600;
    letter-spacing: -.01em; line-height: 1; display: inline-flex; align-items: baseline; gap: .45rem;
    color: #fff; transition: color .35s;
  }
  .nav-brand-sub {
    font-family: var(--font-mono); font-size: .6rem; font-weight: 400;
    letter-spacing: .14em; text-transform: uppercase; opacity: .72;
  }

  .nav-links { display: flex; gap: 2rem; align-items: center; list-style: none; }
  .nav-link { font-size: .9rem; font-weight: 500; color: rgba(255,255,255,.85); transition: color .2s; }
  .nav-link:hover { color: #fff; }

  /* ── Dropdowns ─────────────────────────────────────────────────────────── */
  .nav-group { position: relative; }
  .nav-parent { display: inline-flex; align-items: center; gap: .32rem; }
  .nav-parent .caret { transition: transform .25s ease; opacity: .8; }
  .nav-group:hover .caret,
  .nav-group:focus-within .caret { transform: rotate(180deg); }

  .nav-dropdown {
    position: absolute; top: 100%; left: 50%; transform: translate(-50%, 8px);
    min-width: 216px; list-style: none; margin: .55rem 0 0; padding: .4rem;
    background: #fff; border: 1px solid rgba(6,50,46,.08);
    border-radius: 14px; box-shadow: 0 18px 40px -18px rgba(6,50,46,.3);
    opacity: 0; visibility: hidden; transition: opacity .22s ease, transform .22s ease;
  }
  /* Invisible bridge so the cursor can cross the gap without closing the menu */
  .nav-dropdown::before { content: ''; position: absolute; left: 0; right: 0; top: -12px; height: 12px; }
  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .nav-dropdown a {
    display: block; padding: .6rem .85rem; border-radius: 9px;
    font-size: .9rem; font-weight: 500; color: var(--ink-soft); white-space: nowrap;
    transition: background .18s, color .18s;
  }
  .nav-dropdown a:hover { background: rgba(0,180,162,.1); color: var(--teal-deep); }

  .nav-book {
    background: var(--sun); color: #fff; padding: .6rem 1.35rem; border-radius: 50px;
    font-size: .875rem; font-weight: 600; box-shadow: 0 6px 16px rgba(255,107,61,.28);
    transition: background .2s, transform .2s;
  }
  .nav-book:hover { background: var(--sun-light); transform: translateY(-1px); }

  /* Dark-text state: solid nav, or transparent nav once scrolled */
  .site-nav.is-solid .nav-brand,
  .site-nav.scrolled .nav-brand { color: var(--ink); }
  .site-nav.is-solid .nav-link,
  .site-nav.scrolled .nav-link { color: var(--ink-soft); }
  .site-nav.is-solid .nav-link:hover,
  .site-nav.scrolled .nav-link:hover { color: var(--ink); }

  .nav-burger { display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border: none; padding: 6px; }
  .nav-burger span { display: block; width: 24px; height: 2px; background: #fff; border-radius: 2px; transition: .3s; }
  .site-nav.is-solid .nav-burger span,
  .site-nav.scrolled .nav-burger span { background: var(--ink); }

  .nav-mobile {
    position: absolute; top: 100%; left: 0; right: 0;
    display: none; flex-direction: column; gap: 1.1rem; list-style: none;
    padding: 1.25rem 1.5rem 1.75rem; background: var(--sand);
    border-bottom: 1px solid rgba(6,50,46,.12);
    box-shadow: 0 14px 30px rgba(6,50,46,.14);
    max-height: calc(100vh - 74px); overflow-y: auto;
  }
  .nav-mobile[hidden] { display: none; }
  .nav-mobile.open { display: flex; }
  .nav-mobile > li > a { color: var(--ink); font-weight: 600; }
  .nav-mobile > li > a:hover { color: var(--teal-deep); }

  /* Mobile accordion groups */
  .m-group { display: flex; flex-direction: column; }
  .m-parent {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    width: 100%; background: none; border: none; padding: 0; cursor: pointer;
    font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: var(--ink);
  }
  .m-caret { font-size: 1.3rem; line-height: 1; color: var(--teal-deep); transition: transform .25s ease; }
  .m-group.open .m-caret { transform: rotate(45deg); }
  .m-sub {
    list-style: none; display: flex; flex-direction: column; gap: 0;
    max-height: 0; overflow: hidden; padding-left: .9rem;
    transition: max-height .3s ease, margin-top .3s ease, gap .3s ease;
  }
  .m-group.open .m-sub { max-height: 320px; margin-top: 1rem; gap: .9rem; }
  .m-sub a { color: var(--ink-soft); font-weight: 500; font-size: .95rem; }
  .m-sub a:hover { color: var(--teal-deep); }

  @media (max-width: 860px) {
    .nav-links, .nav-book { display: none; }
    .nav-burger { display: flex; }
  }

  :global(:focus-visible) { outline: 3px solid var(--teal); outline-offset: 3px; border-radius: 4px; }
</style>

<script>
  const nav = document.getElementById('siteNav')
  if (nav?.classList.contains('is-transparent')) {
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 50)
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
  }

  const burger = document.getElementById('burger')
  const menu = document.getElementById('mobileMenu')
  burger?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open')
    if (menu) menu.hidden = !open
    burger.setAttribute('aria-expanded', String(!!open))
  })

  // Mobile dropdown accordions
  menu?.querySelectorAll<HTMLButtonElement>('.m-parent').forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.m-group')
      const open = group?.classList.toggle('open')
      btn.setAttribute('aria-expanded', String(!!open))
    })
  })

  // Close the whole mobile menu when a real link is tapped
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    menu.classList.remove('open'); menu.hidden = true
    burger?.setAttribute('aria-expanded', 'false')
  }))
</script>
