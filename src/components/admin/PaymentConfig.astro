---
export const prerender = false
import { supabase } from '../../lib/supabase'

interface Props {
  authToken: string
}

const { authToken } = Astro.props

const defaultConfig = {
  provider: 'on-site',
  paypal_client_id: '',
  paypal_secret: '',
  paypal_sandbox: true,
  square_access_token: '',
  square_application_id: '',
  square_location_id: '',
  square_sandbox: true,
}

let config: any = { ...defaultConfig }
let error = ''

// Load directly from Supabase during SSR. Self-fetching this API can fail on Vercel serverless.
try {
  const { data, error: dbError } = await supabase
    .from('payment_config')
    .select('*')
    .eq('is_active', true)
    .limit(1)

  if (dbError) {
    console.error('Supabase payment_config error:', dbError)
    error = 'Failed to load payment config: ' + dbError.message
  } else if (data && data.length > 0) {
    config = { ...defaultConfig, ...data[0] }
  }
} catch (e) {
  error = 'Failed to load payment config: ' + (e instanceof Error ? e.message : 'Unknown error')
}
---

<div class="adm-card" style="margin-bottom: 24px;">
  <div class="adm-card-p">
    <div style="font-size:15px;font-weight:700;color:#0F172A;margin-bottom:20px">Payment Configuration</div>

    {error && (
      <div style="background:#FEE2E2;border:1px solid #FECDD3;color:#DC2626;padding:10px 14px;border-radius:10px;margin-bottom:16px;font-size:13px">
        {error}
      </div>
    )}

    <form id="payment-config-form">
      <!-- Provider Selection -->
      <div style="margin-bottom:20px">
        <div class="adm-label">Active Payment Provider</div>
        <div style="display:flex;flex-direction:column;gap:10px">
          {[
            { value: 'square', label: '⬛ Square (Primary)' },
            { value: 'paypal', label: '🅿️ PayPal (Backup)' },
            { value: 'on-site', label: '💳 On-Site Payment (Manual)' },
          ].map(({ value, label }) => (
            <label style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:8px 10px;border-radius:10px;border:1.5px solid transparent;transition:border-color 0.15s" class="provider-label" data-provider={value}>
              <input
                type="radio"
                name="provider"
                value={value}
                checked={config.provider === value}
                style="accent-color:#00BCD4;cursor:pointer"
                class="pvss-provider-radio"
              />
              <span style="font-size:13px;font-weight:500;color:#475569">{label}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- PayPal Config -->
      <div id="paypal-config" style={`display:${config.provider === 'paypal' ? 'block' : 'none'}`}>
        <div style="background:#EFF6FF;border-left:4px solid #3B82F6;padding:12px 14px;margin-bottom:16px;border-radius:6px">
          <div style="font-size:12px;color:#1E40AF;font-weight:500">PayPal will be enabled when you save this configuration.</div>
        </div>

        <div style="margin-bottom:14px">
          <label class="adm-label">PayPal Client ID</label>
          <input
            type="text"
            name="paypal_client_id"
            value={config.paypal_client_id || ''}
            class="adm-input"
            placeholder="AEDyxxx..."
            style="font-family:monospace;font-size:12px"
          />
          <div style="font-size:11px;color:#64748B;margin-top:4px">From PayPal Developer Dashboard</div>
        </div>

        <div style="margin-bottom:14px">
          <label class="adm-label">PayPal Secret</label>
          <input
            type="password"
            name="paypal_secret"
            value={config.paypal_secret || ''}
            class="adm-input"
            placeholder="••••••••"
          />
          <div style="font-size:11px;color:#64748B;margin-top:4px">Keep this secret</div>
        </div>

        <div style="margin-bottom:14px">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
            <input
              type="checkbox"
              name="paypal_sandbox"
              id="paypal_sandbox"
              checked={config.paypal_sandbox !== false}
              style="accent-color:#00BCD4;width:16px;height:16px;cursor:pointer"
            />
            <div>
              <div style="font-size:13px;font-weight:600;color:#0F172A">Sandbox Mode (Test)</div>
              <div style="font-size:11px;color:#64748B;margin-top:2px">Use PayPal sandbox for testing — disable for real payments</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Square Config -->
      <div id="square-config" style={`display:${config.provider === 'square' ? 'block' : 'none'}`}>
        <div style="background:#EFF6FF;border-left:4px solid #3B82F6;padding:12px 14px;margin-bottom:16px;border-radius:6px">
          <div style="font-size:12px;color:#1E40AF;font-weight:500">Get these values from your Square Developer Dashboard → Applications.</div>
        </div>

        <div style="margin-bottom:14px">
          <label class="adm-label">Square Access Token</label>
          <input
            type="password"
            name="square_access_token"
            value={config.square_access_token || ''}
            class="adm-input"
            placeholder="EAAAl..."
          />
          <div style="font-size:11px;color:#64748B;margin-top:4px">Sandbox: starts with EAAAlxxx · Production: starts with EAAAl (never share this)</div>
        </div>

        <div style="margin-bottom:14px">
          <label class="adm-label">Application ID</label>
          <input
            type="text"
            name="square_application_id"
            value={config.square_application_id || ''}
            class="adm-input"
            placeholder="sandbox-sq0idb-xxx or sq0idp-xxx"
            style="font-family:monospace;font-size:12px"
          />
          <div style="font-size:11px;color:#64748B;margin-top:4px">Sandbox: starts with sandbox-sq0idb- · Production: starts with sq0idp-</div>
        </div>

        <div style="margin-bottom:14px">
          <label class="adm-label">Location ID</label>
          <input
            type="text"
            name="square_location_id"
            value={config.square_location_id || ''}
            class="adm-input"
            placeholder="LXXXXXXXXXXXXXXXXX"
            style="font-family:monospace;font-size:12px"
          />
          <div style="font-size:11px;color:#64748B;margin-top:4px">From Square Dashboard → Locations</div>
        </div>

        <div style="margin-bottom:14px">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
            <input
              type="checkbox"
              name="square_sandbox"
              id="square_sandbox"
              checked={config.square_sandbox !== false}
              style="accent-color:#00BCD4;width:16px;height:16px;cursor:pointer"
            />
            <div>
              <div style="font-size:13px;font-weight:600;color:#0F172A">Sandbox Mode (Test)</div>
              <div style="font-size:11px;color:#64748B;margin-top:2px">Use Square sandbox for testing — disable for real payments</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Test Connection (PayPal / Square only) -->
      <div id="payment-test-wrap" style={`display:${config.provider === 'on-site' ? 'none' : 'block'};margin-top:16px`}>
        <button
          type="button"
          id="payment-test-btn"
          class="adm-btn"
          style="width:100%;background:#fff;color:#0F172A;border:1.5px solid #CBD5E1"
        >
          🧪 Test Connection
        </button>
        <div style="font-size:11px;color:#64748B;margin-top:6px;text-align:center">
          Uses the values in this form (no need to save first). Nothing is charged.
        </div>
        <div id="payment-test-result" hidden style="margin-top:12px;padding:12px 14px;border-radius:10px;font-size:13px;line-height:1.5"></div>
      </div>

      <!-- Save Button -->
      <button
        type="button"
        id="payment-config-save-btn"
        class="adm-btn adm-btn-teal"
        style="margin-top:16px;width:100%"
      >
        Save Payment Configuration
      </button>

      <div id="payment-config-message" style="margin-top:12px;font-size:13px;font-weight:500;text-align:center"></div>
    </form>
  </div>
</div>

<script is:inline define:vars={{ authToken }}>
(function() {
  function toggleProvider(provider) {
    document.querySelectorAll('.provider-label').forEach(function(label) {
      var isSelected = label.dataset.provider === provider
      label.style.borderColor = isSelected ? '#00BCD4' : 'transparent'
      label.style.backgroundColor = isSelected ? '#E0F7FA' : 'transparent'
    })
    document.getElementById('paypal-config').style.display = provider === 'paypal' ? 'block' : 'none'
    document.getElementById('square-config').style.display = provider === 'square' ? 'block' : 'none'
    document.getElementById('payment-test-wrap').style.display = provider === 'on-site' ? 'none' : 'block'
    document.getElementById('payment-test-result').hidden = true
  }

  function buildPayload(form) {
    var formData = new FormData(form)
    return {
      provider: formData.get('provider'),
      paypal_client_id: formData.get('paypal_client_id') || null,
      paypal_secret: formData.get('paypal_secret') || null,
      paypal_sandbox: formData.get('paypal_sandbox') === 'on',
      square_access_token: formData.get('square_access_token') || null,
      square_application_id: formData.get('square_application_id') || null,
      square_location_id: formData.get('square_location_id') || null,
      square_sandbox: formData.get('square_sandbox') === 'on',
    }
  }

  function showTestResult(ok, lines, link) {
    var box = document.getElementById('payment-test-result')
    box.replaceChildren()
    box.style.background = ok ? '#ECFDF5' : '#FEE2E2'
    box.style.border = '1px solid ' + (ok ? '#A7F3D0' : '#FECDD3')
    box.style.color = ok ? '#065F46' : '#B91C1C'
    lines.forEach(function(text, i) {
      var p = document.createElement('div')
      p.textContent = text
      if (i === 0) p.style.fontWeight = '700'
      box.appendChild(p)
    })
    if (link) {
      var a = document.createElement('a')
      a.href = link.href
      a.target = '_blank'
      a.rel = 'noopener'
      a.textContent = link.label
      a.style.cssText = 'display:inline-block;margin-top:8px;font-weight:700;color:#0369A1;text-decoration:underline'
      box.appendChild(a)
    }
    box.hidden = false
  }

  function init() {
    var form = document.getElementById('payment-config-form')
    if (!form) return

    // Init styling
    var activeProvider = form.provider.value
    toggleProvider(activeProvider)

    // Radio change listeners
    document.querySelectorAll('.pvss-provider-radio').forEach(function(radio) {
      radio.addEventListener('change', function() {
        toggleProvider(this.value)
      })
    })

    // Test connection button
    var testBtn = document.getElementById('payment-test-btn')
    if (testBtn) {
      testBtn.addEventListener('click', async function() {
        var payload = buildPayload(form)
        testBtn.disabled = true
        testBtn.textContent = 'Testing…'

        try {
          var res = await fetch('/api/admin/payment-test', {
            method: 'POST',
            headers: {
              'Authorization': 'Bearer ' + authToken,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          })
          var data = await res.json().catch(function() { return {} })

          if (!res.ok) {
            showTestResult(false, ['✗ Connection failed', data.error || ('HTTP ' + res.status)])
          } else if (data.provider === 'paypal') {
            var sandbox = data.mode === 'sandbox'
            showTestResult(
              true,
              [
                '✓ PayPal connected — ' + (sandbox ? 'SANDBOX (test)' : 'LIVE (real payments)'),
                'Credentials are valid. Test order ' + data.orderId + ' for $1.00 was created (not captured, nothing charged).',
                sandbox
                  ? 'Optional: open the link and log in with a sandbox buyer account to check the checkout page.'
                  : 'Live mode: do not pay the test order — it would be a real $1.00 payment.',
              ],
              sandbox && data.approveUrl ? { href: data.approveUrl, label: 'Open sandbox checkout →' } : null
            )
          } else {
            showTestResult(true, [
              '✓ Square connected — ' + (data.mode === 'sandbox' ? 'SANDBOX (test)' : 'LIVE (real payments)'),
              'Location: ' + data.locationName + ' · ' + data.locationStatus + (data.currency ? ' · ' + data.currency : ''),
            ])
          }
        } catch (e) {
          showTestResult(false, ['✗ Network error', e.message])
        } finally {
          testBtn.disabled = false
          testBtn.textContent = '🧪 Test Connection'
        }
      })
    }

    // Save button
    var saveBtn = document.getElementById('payment-config-save-btn')
    if (saveBtn) {
      saveBtn.addEventListener('click', async function() {
        var payload = buildPayload(form)

        var messageEl = document.getElementById('payment-config-message')

        try {
          var res = await fetch('/api/admin/payment-config', {
            method: 'POST',
            headers: {
              'Authorization': 'Bearer ' + authToken,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          })

          if (res.ok) {
            messageEl.textContent = '✓ Payment configuration saved successfully!'
            messageEl.style.color = '#059669'
            setTimeout(function() { messageEl.textContent = '' }, 4000)
          } else {
            var error = await res.json()
            messageEl.textContent = '✗ Error: ' + (error.error || 'Failed to save')
            messageEl.style.color = '#DC2626'
          }
        } catch (e) {
          messageEl.textContent = '✗ Network error: ' + e.message
          messageEl.style.color = '#DC2626'
        }
      })
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
})()
</script>
