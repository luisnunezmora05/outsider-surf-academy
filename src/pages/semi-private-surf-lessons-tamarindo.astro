---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData, ROUTES } from '../lib/seo'

const seo = seoData.semiPrivateLessons

const crumbs = [
  { name: 'Home', href: ROUTES.HOME },
  { name: 'Surf Lessons', href: ROUTES.SURF_LESSONS },
  { name: 'Semi-Private', href: ROUTES.SEMI_PRIVATE },
]

const why = [
  { ico: '🎯', b: 'Just your group, no strangers', p: "You surf only with the people you booked with. Never lumped in with a crowd you've never met." },
  { ico: '🔎', b: 'Almost private-level attention', p: 'With only 2–3 of you, your instructor watches each person and gives individual corrections.' },
  { ico: '💸', b: 'Lower price per person', p: 'Sharing one instructor means it costs noticeably less per head than going fully private.' },
  { ico: '🗓️', b: 'Flexible scheduling', p: "Since it's just your group, we build the lesson around the time and tide that work for you." },
]

const perfectFor = [
  { ico: '💑', b: 'Couples', p: 'Vacation or honeymoon, sharing the experience.' },
  { ico: '🧑‍🤝‍🧑', b: 'Two friends', p: 'Surf with each other, not with strangers.' },
  { ico: '👨‍👦', b: 'Parent & teen', p: 'Or two siblings, learning side by side.' },
  { ico: '👥', b: 'Small groups of 2–3', p: 'Personal attention without the full private price.' },
  { ico: '⚖️', b: 'Mixed-level pairs', p: 'One beginner, one improver — same session.' },
]

const steps = [
  { n: '01', h: 'Meet & gear your group', p: "We check everyone's experience and fit each person with the right board and rash guard." },
  { n: '02', h: 'Safety & sand practice', p: 'Ocean safety, currents, right-of-way and the pop-up — practiced together on the sand until it clicks.' },
  { n: '03', h: 'Sharing the waves', p: 'Into the water, just your crew. Your instructor moves between you, pushing each into their own waves.' },
  { n: '04', h: 'Feedback for each of you', p: 'Everyone gets individual feedback — what you did well and what to work on next.' },
]

const faqs = [
  { question: 'What is a semi-private surf lesson, exactly?', answer: "It's a lesson for just your small group — 2 to 3 people — sharing one instructor, with no strangers added in. It sits right between a private lesson (one-on-one) and a group lesson. You get most of the personal attention of a private lesson, at a lower price per person, while learning alongside the people you came with." },
  { question: 'Is a semi-private surf lesson good for couples?', answer: "It's the most popular choice for couples in Tamarindo. It's just the two of you and your instructor — you learn side by side, cheer each other on, and walk away with photos and a shared story. Far more personal attention than a group lesson, without paying for two separate private ones." },
  { question: 'Can my partner and I take a lesson together if one of us has surfed before?', answer: "Yes, and it's one of the best things about semi-private. With only 2–3 of you, your instructor adapts to each person — pushing the first-timer into gentle waves while giving the more experienced surfer tips to improve. Nobody holds anyone back, and nobody waits around." },
  { question: 'How much does a semi-private surf lesson cost in Tamarindo?', answer: "Semi-private lessons start at $65 per person, including the board, rash guard, leash, wax, your instructor and session photos. Because you share one instructor across your group, it's cheaper per person than a private lesson." },
  { question: 'How many people can be in a semi-private lesson?', answer: "A semi-private lesson is for 2 to 3 people, plus your instructor — and only your group. You're never paired with strangers. With 4 or more, it becomes a group lesson, which we're happy to set up too." },
  { question: "What's the difference between a semi-private and a group surf lesson?", answer: 'Who you surf with. Semi-private is just your own group of 2–3 — no outsiders. A group lesson is a small class (up to 4) that may include other travelers. Semi-private gives more personal attention and privacy; group is more social and a bit cheaper per person.' },
  { question: 'Can a family do a semi-private surf lesson together?', answer: "Definitely — a parent with one or two kids is a classic semi-private group. You all learn together, with the instructor's attention split just among your family. We teach kids from age 6, always in shallow, sandy-bottom water with the instructor right beside them." },
  { question: 'Will we actually get individual attention, or is it like a big group lesson?', answer: "You'll get real individual attention — that's the whole point. With just 2–3 of you, your instructor can watch each person and correct your stance wave by wave. It's nothing like the crowded lessons where one instructor manages 8 or 10 beginners at once." },
  { question: 'Can we choose our own lesson time as a semi-private group?', answer: "Usually yes — because it's just your group, semi-private lessons are some of the easiest to schedule flexibly. We still time your lesson to the best tide so you catch the most waves, but within that we work around your group's plans. Message us with the days you're in Tamarindo." },
  { question: 'Do you provide all the surf equipment?', answer: "Yes — everything's included for each person: a soft-top board matched to size, rash guard, leash, wax, plus session photos. You just bring a swimsuit, reef-safe sunscreen and water. No rentals or surprise fees at the beach." },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms} transparentNav={true}>
  <BreadcrumbSchema slot="head" items={crumbs} />
  <FAQSchema slot="head" items={faqs} />

  <div class="sl">

    <!-- ═══════════ HERO ═══════════ -->
    <header class="hero">
      <div class="hero-inner">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href={ROUTES.HOME}>Home</a> / <a href={ROUTES.SURF_LESSONS}>Surf Lessons</a> / Semi-Private
        </nav>
        <div class="hero-coords"><span class="dot"></span>Tamarindo · Guanacaste · Costa Rica</div>
        <h1>Semi-Private Surf Lessons in Tamarindo <span class="accent">— just your crew and the waves</span></h1>
        <p class="hero-sub">Your group of two or three, one instructor, no strangers. Nearly the attention of a private lesson at a lower price per person — with the people you came to surf with.</p>
        <div class="hero-ctas">
          <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book From $65/person
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <div class="hero-rating"><span class="stars">★★★★★</span><span><b>Rated 5.0</b> on Google</span></div>
        </div>
      </div>
      <div class="hero-wave" aria-hidden="true"><svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0,36 C240,80 480,4 720,32 C960,60 1200,12 1440,44 L1440,80 L0,80 Z" fill="#06322E"/></svg></div>
    </header>

    <!-- ═══════════ BOOK BAND (flows out of the wave) ═══════════ -->
    <section class="bookband" aria-label="Semi-private surf lesson at a glance">
      <div class="wrap">
        <div class="bookband-grid">
          <div class="bb-item"><div class="bb-k">Price</div><div class="bb-v">from $65 <small>/ person</small></div></div>
          <div class="bb-item"><div class="bb-k">Duration</div><div class="bb-v">~90 min</div></div>
          <div class="bb-item"><div class="bb-k">Group size</div><div class="bb-v">2–3 <small>your group only</small></div></div>
          <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book Now</a>
        </div>
      </div>
    </section>

    <!-- ═══════════ WHY ═══════════ -->
    <section id="why">
      <div class="wrap">
        <span class="eyebrow">Why Semi-Private</span>
        <h2>Why choose a semi-private surf lesson?</h2>
        <p class="lead">Semi-private is the sweet spot — the most personal way to learn together without paying for two private lessons.</p>
        <div class="why-grid">
          {why.map(w => (
            <div class="why-item reveal"><div class="ico">{w.ico}</div><div><b>{w.b}</b><p>{w.p}</p></div></div>
          ))}
        </div>
        <div class="couples-note reveal">❤️ <b>Is it right for couples and friends?</b> Almost certainly. You learn side by side, walk away with a shared story and photos, and there's no holding back in front of strangers — just your crew, the instructor and the ocean.</div>
      </div>
    </section>

    <!-- ═══════════ LEVELS (key differentiator) ═══════════ -->
    <section class="levels">
      <div class="wrap levels-inner">
        <div>
          <span class="eyebrow gold">Mixed Levels Welcome</span>
          <h2>Can you take it at different levels?</h2>
          <p>A common worry: "My partner has surfed before and I've never touched a board — won't one of us hold the other back?"</p>
          <p>In a semi-private lesson, that's not a problem. With just 2–3 of you, your instructor adapts to each person — pushing the complete beginner into gentle whitewash while giving the more experienced surfer tips to improve, all in the same session.</p>
          <p><strong>Nobody waits. Nobody gets left behind.</strong></p>
        </div>
        <div class="levels-card reveal">
          <div class="row"><div class="ic">🌱</div><div><b>The first-timer</b><span>Gets pushed into gentle, beginner-friendly waves and coached on the pop-up.</span></div></div>
          <div class="row"><div class="ic">📈</div><div><b>The one who's surfed before</b><span>Gets tips to paddle better, read waves and improve technique.</span></div></div>
          <div class="row"><div class="ic">🤝</div><div><b>Both, same session</b><span>One instructor, side by side, each at your own level.</span></div></div>
        </div>
      </div>
    </section>

    <!-- ═══════════ PERFECT FOR ═══════════ -->
    <section>
      <div class="wrap">
        <span class="eyebrow">Who It's For</span>
        <h2>Who semi-private lessons are perfect for</h2>
        <div class="perfect-grid">
          {perfectFor.map(p => (
            <div class="pf reveal"><div class="ico">{p.ico}</div><b>{p.b}</b><p>{p.p}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ INCLUDED ═══════════ -->
    <section class="included" id="included">
      <div class="wrap">
        <span class="eyebrow">What's Included</span>
        <h2>Everything's included for your whole group</h2>
        <p class="lead">No hidden fees, no equipment charges sprung on you at the beach.</p>
        <div class="inc-grid">
          <ul class="inc-list reveal">
            <li><span class="ck">✓</span><div><b>A bilingual instructor</b><span>English / Spanish — dedicated to your group alone</span></div></li>
            <li><span class="ck">✓</span><div><b>A soft-top board for each person</b><span>Matched to size and level</span></div></li>
            <li><span class="ck">✓</span><div><b>Rash guard, leash &amp; wax</b><span>For everyone, set up before you arrive</span></div></li>
            <li><span class="ck">✓</span><div><b>Tide-timed scheduling</b><span>Your lesson at the day's best window</span></div></li>
            <li><span class="ck">✓</span><div><b>Photos of your group's session</b><span>To take home</span></div></li>
          </ul>
          <aside class="inc-aside reveal">
            <h3>Each of you brings</h3>
            <p>A swimsuit, reef-safe sunscreen and water. Leave valuables at your hotel — you'll all be in the ocean.</p>
            <span class="tag">Lessons run ~90 min</span>
            <p style="margin-top:14px">A short safety-and-technique session on the sand, then the rest in the water, with your instructor moving between you to keep everyone progressing.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ═══════════ STEPS ═══════════ -->
    <section class="steps" id="steps">
      <div class="wrap">
        <span class="eyebrow">How It Works</span>
        <h2>Your semi-private lesson, step by step</h2>
        <p class="lead">Here's how your 90 minutes flow when it's just your group.</p>
        <div class="steps-grid">
          {steps.map(s => (
            <div class="step reveal"><div class="num">{s.n}</div><h3>{s.h}</h3><p>{s.p}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ COMPARE 3-WAY ═══════════ -->
    <section class="compare">
      <div class="wrap">
        <span class="eyebrow">Which to Pick</span>
        <h2>Semi-private vs private vs group</h2>
        <p class="lead">Three formats, three different goals. Here's the honest breakdown.</p>
        <div class="cmp-grid">
          <div class="cmp is-semi reveal">
            <span class="badge">You're here</span>
            <span class="tag">Semi-private · from $65</span>
            <h3>The middle ground</h3>
            <p>Almost the attention of private, a lower price per person, and you surf only with your own group. Best for couples and small groups.</p>
          </div>
          <div class="cmp reveal">
            <span class="tag tag-teal">Private · from $80</span>
            <h3>Fastest progress</h3>
            <p>One-on-one, the most reassuring if you're nervous or short on time.</p>
            <a href={ROUTES.PRIVATE}>See private →</a>
          </div>
          <div class="cmp reveal">
            <span class="tag tag-teal">Group · from $50</span>
            <h3>Most social &amp; affordable</h3>
            <p>A small group of up to 4 that may include other travelers. Best for solo travelers and budgets.</p>
            <a href={ROUTES.GROUP}>See group →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ GUARANTEE ═══════════ -->
    <!-- TODO: confirm the "stand up or next lesson free" guarantee terms with the client before going live -->
    <section class="guarantee">
      <div class="wrap">
        <div class="guarantee-box reveal">
          <span class="eyebrow gold center">Our Promise</span>
          <h2>Stand up on your first lesson — guaranteed</h2>
          <p>If you don't stand up and ride a wave in your first lesson, your next one is on us. With just your small group and an instructor moving between you, standing up on day one is what we plan for — for everyone in your crew.</p>
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIALS ═══════════ -->
    <section class="testimonials">
      <div class="wrap">
        <span class="eyebrow">Reviews</span>
        <h2>What our students say</h2>
        <div class="testi-grid">
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"We booked a semi-private for our honeymoon and it was the highlight of the trip. Just the two of us and our instructor — we both stood up on the first session and have the photos to prove it."</p><footer>Sophie L.<span>London, UK · Google</span></footer></div>
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"My wife had surfed before and I hadn't, and I was worried I'd hold her back. The instructor split his attention perfectly — she improved, I stood up, nobody waited around."</p><footer>Jake M.<span>Seattle, USA · Google</span></footer></div>
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"Did this with my teenage daughter. Loved that it was just the two of us with the coach, no strangers. Personal, safe and so much fun — we're already planning to come back."</p><footer>Carlos R.<span>Toronto, Canada · Google</span></footer></div>
        </div>
        <!-- TODO: point to your Google Business reviews URL -->
        <p style="text-align:center;margin-top:28px"><a href="#" class="lp-btn lp-btn-line">Read all reviews on Google</a></p>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section class="faq" id="faq">
      <div class="wrap-narrow">
        <span class="eyebrow">FAQ</span>
        <h2>Semi-private surf lesson FAQs</h2>
        <div style="margin-top:34px">
          {faqs.map(f => (
            <details class="reveal"><summary>{f.question}</summary><p>{f.answer}</p></details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA ═══════════ -->
    <section class="cta" id="book">
      <div class="wrap">
        <div class="cta-box reveal">
          <h2>Book your semi-private surf lesson in Tamarindo</h2>
          <p>Grab your partner, your friend or your family — the waves are waiting. Book online in two minutes, or message us on WhatsApp and we'll help you sort out your group.</p>
          <div class="cta-ctas">
            <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book Now</a>
            <a href={ROUTES.CONTACT} class="lp-btn lp-btn-white">Message us on WhatsApp</a>
          </div>
          <address>📍 Tamarindo Beach, Guanacaste, Costa Rica</address>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Semi-private surf lessons — scoped local styles, reusing the global Outsider
     palette tokens defined in global.css. Ported from the approved prototype. */
  .sl { --teal-light:#5FD3C6; }
  .sl :global(*) { box-sizing:border-box; }

  .wrap { max-width:1120px; margin:0 auto; padding:0 24px; }
  .wrap-narrow { max-width:860px; margin:0 auto; padding:0 24px; }
  .sl section { padding:84px 0; }

  .eyebrow { display:inline-flex; align-items:center; gap:.6rem; font-family:var(--font-mono); font-size:.72rem; letter-spacing:.18em; text-transform:uppercase; color:var(--teal-deep); margin-bottom:14px; }
  .eyebrow::before { content:""; width:22px; height:1.5px; background:var(--sun); }
  .eyebrow.gold { color:var(--gold); }
  .eyebrow.gold::before { background:var(--gold); }
  .eyebrow.center { justify-content:center; }
  .lead { color:var(--ink-soft); max-width:660px; margin-top:14px; }

  .lp-btn { display:inline-flex; align-items:center; gap:9px; padding:15px 28px; border-radius:999px; font-weight:700; font-size:1rem; text-decoration:none; cursor:pointer; border:none; font-family:var(--font-body); transition:transform .18s ease,box-shadow .18s ease; }
  .lp-btn:hover { transform:translateY(-2px); }
  .lp-btn svg { width:16px; height:16px; }
  .lp-btn-sun { background:var(--sun); color:#fff; box-shadow:0 14px 28px -12px rgba(255,107,61,.5); }
  .lp-btn-line { background:transparent; color:var(--ink); border:2px solid rgba(6,50,46,.2); }
  .lp-btn-line:hover { border-color:var(--ink); }
  .lp-btn-white { background:#fff; color:var(--teal-deep); }

  /* HERO */
  .hero { position:relative; overflow:hidden; color:#fff;
    background:radial-gradient(1100px 480px at 82% -12%,rgba(255,107,61,.22),transparent 58%),
    linear-gradient(160deg,#04413B 0%,#06322E 30%,#00897C 72%,#00B4A2 105%); }
  .hero-inner { max-width:1120px; margin:0 auto; padding:120px 24px 138px; position:relative; z-index:2; }
  .crumb { font-family:var(--font-mono); font-size:.72rem; color:rgba(255,255,255,.7); margin-bottom:18px; letter-spacing:.04em; }
  .crumb a { color:rgba(255,255,255,.7); text-decoration:none; }
  .crumb a:hover { color:#fff; }
  .hero-coords { display:inline-flex; align-items:center; gap:9px; font-family:var(--font-mono); font-size:.74rem; letter-spacing:.1em; text-transform:uppercase; color:rgba(255,255,255,.82); margin-bottom:20px; }
  .hero-coords .dot { width:8px; height:8px; border-radius:50%; background:var(--gold); box-shadow:0 0 0 4px rgba(255,201,92,.25); }
  .hero h1 { font-family:var(--font-display); font-size:clamp(2.2rem,5vw,3.6rem); font-weight:600; line-height:1.12; letter-spacing:-.01em; max-width:800px; color:#fff; }
  .hero h1 .accent { color:var(--gold); font-style:italic; font-weight:500; }
  .hero-sub { margin:22px 0 32px; font-size:1.12rem; max-width:600px; color:rgba(255,255,255,.88); }
  .hero-ctas { display:flex; gap:14px; flex-wrap:wrap; align-items:center; }
  .hero-rating { display:flex; align-items:center; gap:9px; font-size:.92rem; color:rgba(255,255,255,.9); margin-left:4px; }
  .hero-rating .stars { color:var(--gold); letter-spacing:1px; }
  .hero-wave { position:absolute; bottom:-1px; left:0; width:100%; line-height:0; z-index:1; }
  .hero-wave svg { width:100%; height:80px; display:block; }

  /* BOOK BAND — flows straight out of the dark hero wave */
  .bookband { background:var(--ink); position:relative; z-index:2; }
  .sl section.bookband { padding:2.6rem 0 3rem; }
  .bookband-grid { display:grid; grid-template-columns:repeat(3,1fr) auto; align-items:center; gap:2.5rem; }
  .bb-item { position:relative; }
  .bb-item + .bb-item::before { content:''; position:absolute; left:-1.25rem; top:50%; transform:translateY(-50%); width:1px; height:42px; background:rgba(247,242,234,.16); }
  .bb-k { font-family:var(--font-mono); font-size:.68rem; text-transform:uppercase; letter-spacing:.1em; color:rgba(247,242,234,.6); }
  .bb-v { font-family:var(--font-display); font-size:1.5rem; color:#fff; margin-top:4px; }
  .bb-v small { font-family:var(--font-body); font-size:.78rem; color:rgba(247,242,234,.6); font-weight:600; }
  .bookband-grid .lp-btn { justify-self:end; }

  /* WHY */
  .why-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-top:40px; }
  .why-item { background:#fff; border-radius:var(--radius); padding:24px 26px; box-shadow:0 10px 30px -22px rgba(6,50,46,.3); display:flex; gap:16px; align-items:flex-start; }
  .why-item .ico { flex:0 0 44px; height:44px; border-radius:12px; background:var(--foam); display:flex; align-items:center; justify-content:center; font-size:1.3rem; }
  .why-item b { display:block; font-family:var(--font-display); font-size:1.08rem; margin-bottom:5px; }
  .why-item p { font-size:.93rem; color:var(--ink-soft); }
  .couples-note { margin-top:24px; background:var(--sun-soft); border-left:4px solid var(--sun); border-radius:0 14px 14px 0; padding:20px 24px; font-size:.97rem; }
  .couples-note b { font-family:var(--font-display); }

  /* LEVELS HIGHLIGHT */
  .levels { background:var(--ink); color:#fff; }
  .levels-inner { display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center; }
  .levels h2 { color:#fff; }
  .levels p { color:rgba(255,255,255,.82); margin-top:14px; }
  .levels p + p { margin-top:14px; }
  .levels-card { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.13); border-radius:var(--radius); padding:28px; }
  .levels-card .row { display:flex; gap:14px; align-items:flex-start; margin-bottom:16px; }
  .levels-card .row:last-child { margin-bottom:0; }
  .levels-card .ic { flex:0 0 40px; height:40px; border-radius:11px; background:var(--teal); display:flex; align-items:center; justify-content:center; font-size:1.1rem; }
  .levels-card b { display:block; color:#fff; }
  .levels-card span { font-size:.9rem; color:rgba(255,255,255,.72); }

  /* PERFECT FOR */
  .perfect-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:16px; margin-top:40px; }
  .pf { background:#fff; border-radius:var(--radius); padding:22px 18px; box-shadow:0 10px 30px -22px rgba(6,50,46,.28); text-align:center; }
  .pf .ico { font-size:1.7rem; margin-bottom:10px; }
  .pf b { display:block; font-family:var(--font-display); font-size:.96rem; margin-bottom:6px; }
  .pf p { font-size:.83rem; color:var(--ink-soft); }

  /* INCLUDED */
  .included { background:var(--foam); }
  .inc-grid { display:grid; grid-template-columns:1.2fr 1fr; gap:50px; margin-top:40px; align-items:start; }
  .inc-list { list-style:none; display:grid; gap:16px; }
  .inc-list li { display:flex; gap:14px; align-items:flex-start; }
  .inc-list .ck { flex:0 0 26px; height:26px; border-radius:8px; background:var(--teal); display:flex; align-items:center; justify-content:center; font-size:.8rem; font-weight:800; color:#06322E; }
  .inc-list b { display:block; font-size:.98rem; }
