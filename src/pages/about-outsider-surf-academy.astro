---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData, ROUTES } from '../lib/seo'

const seo = seoData.aboutUs

const crumbs = [
  { name: 'Home', href: ROUTES.HOME },
  { name: 'About', href: ROUTES.ABOUT },
]

const trust = [
  { ico: '🎓', b: 'ISA-certified', s: 'First-aid & water-safety trained' },
  { ico: '💬', b: 'Bilingual', s: 'Lessons in English & Spanish' },
  { ico: '📍', b: 'Local', s: 'We surf Tamarindo every day' },
]

// TODO: replace [Name] / [X] years / bios / photos with the real instructor data before launch.
const team = [
  {
    initial: 'F', role: 'Head Instructor',
    bio: 'Born and raised in Guanacaste, surfing Tamarindo for [X] years. His specialty: getting nervous first-timers standing up before they have time to overthink it.',
    creds: ['ISA Certified', 'First Aid', 'EN / ES'],
  },
  {
    initial: 'F', role: 'Instructor',
    bio: '[X] years teaching beginners and kids in Tamarindo. The most patient person on this beach — the one parents request when they bring their kids back.',
    creds: ['ISA Certified', 'Lifeguard', 'EN / ES'],
  },
  {
    initial: 'F', role: 'Instructor',
    bio: '[Real bio: where they learned, years of experience, and the specialty or human trait that makes them memorable.]',
    creds: ['ISA Certified', 'First Aid', 'EN / ES'],
  },
]

const diff = [
  { ico: '👥', b: 'We stay small on purpose', p: "Capped groups, never a crowd. You're a student, not a ticket number." },
  { ico: '🤙', b: 'Your instructor knows your name', p: 'And your goals, your fears, and what you worked on last lesson.' },
  { ico: '🌊', b: 'We teach where we surf', p: 'This is our home break. We know which sandbar is working and which tide suits a beginner today.' },
  { ico: '❤️', b: 'Personal beats polished', p: 'Not a resort or a franchise. Direct contact, honest advice, and a team that cares whether you stand up.' },
]

const certified = [
  { ico: '🎓', b: 'Certified', p: 'ISA-certified, with first-aid and water-safety training.' },
  { ico: '💬', b: 'Bilingual', p: 'Fluent lessons in English and Spanish — nothing lost in translation.' },
  { ico: '🧭', b: 'Local', p: "Deep knowledge of Tamarindo's tides, winds, sandbars and conditions." },
]

const safety = [
  { ico: '🌅', b: 'Daily condition checks', s: "We check the ocean every morning and reschedule if it's not right for beginners." },
  { ico: '📋', b: 'Safety briefing every time', s: 'Currents, right-of-way, and how to fall safely — before anyone paddles out.' },
  { ico: '⛑️', b: 'First-aid trained', s: 'Water-safety trained instructors with a kit on the beach.' },
  { ico: '🦶', b: 'Waist-deep learning', s: 'Beginners learn in standing-depth water, instructor within reach the whole time.' },
]

const faqs = [
  { question: 'Are the surf instructors in Tamarindo certified?', answer: 'Yes — every instructor at Outsider Surf Academy is ISA-certified and trained in first aid and water safety. But certification is the baseline. What makes the difference is that our instructors have spent years surfing and teaching on Tamarindo Beach specifically, so they know exactly where to put a nervous beginner to catch a wave safely on the first try.' },
  { question: 'Do the instructors speak English?', answer: "Yes — all our instructors are bilingual and teach fluently in both English and Spanish. That matters more than people expect: when you're nervous in the ocean, you want clear instructions you actually understand, not a language barrier between you and the person keeping you safe." },
  { question: 'Who will be teaching my surf lesson?', answer: 'One of our own named instructors — not an anonymous "guide" or a rotating stranger. You can see our team, with their names, photos and backgrounds, right here before you ever book. You\'ll know who\'s teaching you, and by the end of your first lesson, they\'ll know your name too.' },
  { question: 'Is Outsider Surf Academy a real, legitimate surf school?', answer: "Yes — we're a real, locally run surf school based on Tamarindo Beach in Guanacaste, with named instructors, real Google reviews from past students, and a verified location. If you've ever worried about booking from someone who's basically just a guy with boards on the beach, that's exactly what we're not." },
  { question: 'Are your instructors local to Tamarindo?', answer: "Yes, and it's one of our biggest advantages. Our instructors surf Tamarindo every single day, so they read the local tides, winds and sandbars better than anyone passing through. A certificate teaches the fundamentals; years in this specific water teach you the things that actually get a beginner standing up." },
  { question: 'How experienced are the instructors?', answer: "Our team combines years of surfing Tamarindo with years of actually teaching it — which aren't the same skill. Being a great surfer doesn't make someone a great teacher; patience, clear communication and reading a student's nerves do. We hire and train for the teaching side just as hard as the surfing side." },
  { question: 'What makes Outsider different from the big surf schools?', answer: "The big, long-established schools are great at moving a lot of students every day. We deliberately do the opposite: small groups, named instructors who remember you, and direct WhatsApp contact with the team that actually teaches you. We're newer and smaller on purpose — so you get a personal experience instead of feeling like a number." },
  { question: 'Can I request the same instructor for more than one lesson?', answer: "Absolutely — and we'd encourage it. If you book multiple lessons, having the same instructor means they already know your level, your goals and what you worked on last time, so you pick up right where you left off instead of starting over. Just ask us and we'll arrange it." },
  { question: 'Are your instructors good with kids and nervous beginners?', answer: "Yes — it's honestly what our team is best at. A big part of who we teach are nervous first-timers and kids, so our instructors are chosen for patience as much as skill. Kids learn in shallow, sandy-bottom water with an instructor within arm's reach, and nervous adults get someone who goes entirely at their pace." },
  { question: 'How do I know your instructors are trustworthy before I book?', answer: 'Two easy ways: read our Google reviews, where past students mention our instructors by name, and check out the team above, where every instructor is listed with their photo, experience and certifications. We put our real people front and center precisely so you can decide you trust us before you ever get in the water.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms} transparentNav={true}>
  <BreadcrumbSchema slot="head" items={crumbs} />
  <FAQSchema slot="head" items={faqs} />

  <div class="sl">

    <!-- ═══════════ HERO ═══════════ -->
    <header class="hero">
      <div class="hero-inner">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href={ROUTES.HOME}>Home</a> / About
        </nav>
        <div class="hero-coords"><span class="dot"></span>Tamarindo · Guanacaste · Costa Rica</div>
        <h1>Meet the surf instructors behind <span class="accent">Outsider Surf Academy</span></h1>
        <p class="hero-sub">A small, personal surf school on Tamarindo Beach — run by local, certified instructors who'll know your name by the end of your first lesson. No crowds, no factory-line lessons. Just real coaching from people who surf this beach every day.</p>
      </div>
      <div class="hero-wave" aria-hidden="true"><svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0,36 C240,80 480,4 720,32 C960,60 1200,12 1440,44 L1440,80 L0,80 Z" fill="#06322E"/></svg></div>
    </header>

    <!-- ═══════════ TRUST BAND (flows out of the wave) ═══════════ -->
    <section class="trustband" aria-label="Why students trust Outsider">
      <div class="wrap">
        <div class="trustband-grid">
          {trust.map(t => (
            <div class="tb-item"><div class="tb-ico">{t.ico}</div><div><b>{t.b}</b><span>{t.s}</span></div></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ INSTRUCTORS ═══════════ -->
    <section id="team">
      <div class="wrap">
        <span class="eyebrow">The Team</span>
        <h2>Meet your surf instructors in Tamarindo</h2>
        <p class="lead">You're about to trust someone with your first time in the ocean — you should know exactly who that is. Real names, real faces, real credentials. No anonymous "guides," no rotating strangers.</p>
        <div class="team-grid">
          {team.map(m => (
            <article class="member reveal">
              <div class="member-photo">{m.initial}<span class="ph-note">[Real instructor photo]</span></div>
              <div class="member-body">
                <h3>[Name]</h3>
                <div class="role">{m.role}</div>
                <p>{m.bio}</p>
                <div class="member-creds">{m.creds.map(c => <span class="c">{c}</span>)}</div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ STORY ═══════════ -->
    <!-- TODO: replace the founding-story placeholders ([year], real founding story) with the real history. -->
    <section class="story" id="story">
      <div class="wrap story-inner">
        <span class="eyebrow gold center">Our Story</span>
        <h2>Why we started Outsider Surf Academy</h2>
        <p>Outsider started with a simple frustration: too many surf lessons in Tamarindo treat people like numbers.</p>
        <div class="pull">"We'd watched too many travelers pay for a lesson, get lumped into a crowd of ten, catch one wave by luck, and leave thinking surfing <span class="accent">wasn't for them.</span>"</div>
        <p>We knew it could be better. So in [year] we built the kind of surf school we'd send our own friends and family to — small groups, instructors who actually watch you, and the patience to get anyone, at any age, standing on a board. That's still exactly how we run it today.</p>
      </div>
    </section>

    <!-- ═══════════ DIFFERENT ═══════════ -->
    <section>
      <div class="wrap">
        <span class="eyebrow">Why Outsider</span>
        <h2>What makes Outsider different</h2>
        <p class="lead">There are plenty of surf schools in Tamarindo, some around for decades. Here's why people choose a newer, smaller one.</p>
        <div class="diff-grid">
          {diff.map(d => (
            <div class="diff-item reveal"><div class="ico">{d.ico}</div><div><b>{d.b}</b><p>{d.p}</p></div></div>
          ))}
        </div>
        <div class="diff-note reveal">🤝 We can't claim decades in business yet. What we <strong>can</strong> promise is that you'll never feel like just another booking.</div>
      </div>
    </section>

    <!-- ═══════════ CERTIFIED ═══════════ -->
    <section class="certified">
      <div class="wrap">
        <span class="eyebrow">Qualified</span>
        <h2>Certified, bilingual &amp; local instructors</h2>
        <p class="lead">Behind the friendly approach is real qualification. Every Outsider instructor is:</p>
        <div class="cert-grid">
          {certified.map(c => (
            <div class="cert reveal"><div class="ico">{c.ico}</div><b>{c.b}</b><p>{c.p}</p></div>
          ))}
        </div>
        <p class="cert-line">That last one matters more than people realize. A certificate teaches the fundamentals; years in <em>this</em> water teach you where to put a nervous beginner so they catch a wave on their first try.</p>
      </div>
    </section>

    <!-- ═══════════ SAFETY ═══════════ -->
    <section id="safety">
      <div class="wrap">
        <span class="eyebrow">Safety First</span>
        <h2>Safety is our priority</h2>
        <p class="lead">Before anyone has fun in the ocean, they have to be safe in it. That's not a slogan — it's the routine behind every lesson.</p>
        <ul class="safety-list">
          {safety.map(s => (
            <li class="reveal"><div class="ico">{s.ico}</div><div><b>{s.b}</b><span>{s.s}</span></div></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIALS ═══════════ -->
    <section class="testimonials">
      <div class="wrap">
        <span class="eyebrow">Reviews</span>
        <h2>What our students say</h2>
        <div class="testi-grid">
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"Our instructor was incredible — patient, encouraging and clearly knew exactly where to put us. Stood up on my first lesson and never felt unsafe for a second."</p><footer>Jake M.<span>Seattle, USA · Google</span></footer></div>
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"Small school, huge heart. They remembered our names, our goals, even what we struggled with the day before. This is how a surf lesson should feel."</p><footer>Sophie L.<span>London, UK · Google</span></footer></div>
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"Took the family out and the instructors were amazing with the kids. Certified, calm and local — you can tell they surf this beach every day. Highly recommend."</p><footer>Carlos R.<span>Toronto, Canada · Google</span></footer></div>
        </div>
        <!-- TODO: point to your Google Business reviews URL -->
        <p style="text-align:center;margin-top:28px"><a href="#" class="lp-btn lp-btn-line">Read all reviews on Google</a></p>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section class="faq" id="faq">
      <div class="wrap-narrow">
        <span class="eyebrow">FAQ</span>
        <h2>About our surf instructors</h2>
        <div style="margin-top:34px">
          {faqs.map(f => (
            <details class="reveal"><summary>{f.question}</summary><p>{f.answer}</p></details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA ═══════════ -->
    <section class="cta" id="book">
      <div class="wrap">
        <div class="cta-box reveal">
          <h2>Come surf with us</h2>
          <p>Now that you've met the team, the only thing left is to get in the water. Pick the lesson that fits you, or message us on WhatsApp and we'll help you choose.</p>
          <div class="cta-ctas">
            <a href={ROUTES.SURF_LESSONS} class="lp-btn lp-btn-sun">See Surf Lessons</a>
            <a href={ROUTES.CONTACT} class="lp-btn lp-btn-white">Message us on WhatsApp</a>
          </div>
          <address>📍 Tamarindo Beach, Guanacaste, Costa Rica</address>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* About / instructors — scoped local styles, reusing the global Outsider
     palette tokens defined in global.css. Ported from the approved prototype. */
  .sl { --teal-light:#5FD3C6; }
  .sl :global(*) { box-sizing:border-box; }

  .wrap { max-width:1120px; margin:0 auto; padding:0 24px; }
  .wrap-narrow { max-width:860px; margin:0 auto; padding:0 24px; }
  .sl section { padding:84px 0; }

  .eyebrow { display:inline-flex; align-items:center; gap:.6rem; font-family:var(--font-mono); font-size:.72rem; letter-spacing:.18em; text-transform:uppercase; color:var(--teal-deep); margin-bottom:14px; }
  .eyebrow::before { content:""; width:22px; height:1.5px; background:var(--sun); }
  .eyebrow.gold { color:var(--gold); }
  .eyebrow.gold::before { background:var(--gold); }
  .eyebrow.center { justify-content:center; }
  .lead { color:var(--ink-soft); max-width:660px; margin-top:14px; }

  .lp-btn { display:inline-flex; align-items:center; gap:9px; padding:15px 28px; border-radius:999px; font-weight:700; font-size:1rem; text-decoration:none; cursor:pointer; border:none; font-family:var(--font-body); transition:transform .18s ease,box-shadow .18s ease; }
  .lp-btn:hover { transform:translateY(-2px); }
  .lp-btn svg { width:16px; height:16px; }
  .lp-btn-sun { background:var(--sun); color:#fff; box-shadow:0 14px 28px -12px rgba(255,107,61,.5); }
  .lp-btn-line { background:transparent; color:var(--ink); border:2px solid rgba(6,50,46,.2); }
  .lp-btn-line:hover { border-color:var(--ink); }
  .lp-btn-white { background:#fff; color:var(--teal-deep); }

  /* HERO */
  .hero { position:relative; overflow:hidden; color:#fff;
    background:radial-gradient(1100px 480px at 82% -12%,rgba(255,107,61,.22),transparent 58%),
    linear-gradient(160deg,#04413B 0%,#06322E 30%,#00897C 72%,#00B4A2 105%); }
  .hero-inner { max-width:1120px; margin:0 auto; padding:122px 24px 138px; position:relative; z-index:2; }
  .crumb { font-family:var(--font-mono); font-size:.72rem; color:rgba(255,255,255,.7); margin-bottom:18px; letter-spacing:.04em; }
  .crumb a { color:rgba(255,255,255,.7); text-decoration:none; }
  .crumb a:hover { color:#fff; }
  .hero-coords { display:inline-flex; align-items:center; gap:9px; font-family:var(--font-mono); font-size:.74rem; letter-spacing:.1em; text-transform:uppercase; color:rgba(255,255,255,.82); margin-bottom:20px; }
  .hero-coords .dot { width:8px; height:8px; border-radius:50%; background:var(--gold); box-shadow:0 0 0 4px rgba(255,201,92,.25); }
  .hero h1 { font-family:var(--font-display); font-size:clamp(2.2rem,5vw,3.5rem); font-weight:600; line-height:1.12; letter-spacing:-.01em; max-width:820px; color:#fff; }
  .hero h1 .accent { color:var(--gold); font-style:italic; font-weight:500; }
  .hero-sub { margin:22px 0 0; font-size:1.12rem; max-width:620px; color:rgba(255,255,255,.88); }
  .hero-wave { position:absolute; bottom:-1px; left:0; width:100%; line-height:0; z-index:1; }
  .hero-wave svg { width:100%; height:80px; display:block; }

  /* TRUST BAND — flows straight out of the dark hero wave */
  .trustband { background:var(--ink); position:relative; z-index:2; }
  .sl section.trustband { padding:2.6rem 0 3rem; }
  .trustband-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
  .tb-item { display:flex; gap:14px; align-items:flex-start; justify-content:center; position:relative; }
  .tb-item + .tb-item::before { content:''; position:absolute; left:-.75rem; top:50%; transform:translateY(-50%); width:1px; height:42px; background:rgba(247,242,234,.16); }
  .tb-ico { font-size:1.5rem; line-height:1; }
  .tb-item b { display:block; font-family:var(--font-display); font-size:1.05rem; color:#fff; }
  .tb-item span { font-size:.85rem; color:rgba(247,242,234,.66); }

  /* INSTRUCTORS */
  .team-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:44px; }
  .member { background:#fff; border-radius:var(--radius); overflow:hidden; box-shadow:0 12px 32px -22px rgba(6,50,46,.4); display:flex; flex-direction:column; }
  .member-photo { height:230px; background:linear-gradient(150deg,var(--teal),var(--teal-deep)); display:flex; align-items:center; justify-content:center; color:#fff; font-family:var(--font-display); font-size:3rem; position:relative; }
  .member-photo .ph-note { position:absolute; bottom:10px; left:0; width:100%; text-align:center; font-family:var(--font-mono); font-size:.6rem; color:rgba(255,255,255,.7); letter-spacing:.04em; }
  .member-body { padding:24px; display:flex; flex-direction:column; flex:1; }
  .member-body h3 { font-family:var(--font-display); font-size:1.18rem; }
  .member-body .role { font-family:var(--font-mono); font-size:.7rem; text-transform:uppercase; letter-spacing:.1em; color:var(--sun); font-weight:700; margin:4px 0 12px; }
  .member-body p { font-size:.92rem; color:var(--ink-soft); flex:1; }
  .member-creds { display:flex; flex-wrap:wrap; gap:7px; margin-top:14px; }
  .member-creds .c { font-family:var(--font-mono); font-size:.64rem; background:var(--foam); color:var(--teal-deep); padding:5px 10px; border-radius:999px; letter-spacing:.03em; }

  /* STORY */
  .story { background:var(--ink); color:#fff; }
  .story-inner { max-width:780px; margin:0 auto; text-align:center; }
  .story h2 { color:#fff; }
  .story p { color:rgba(255,255,255,.82); margin-top:16px; font-size:1.05rem; }
  .story .pull { font-family:var(--font-display); font-size:1.4rem; color:#fff; font-style:italic; margin:24px auto; max-width:600px; line-height:1.3; }
  .story .pull .accent { color:var(--gold); }

  /* DIFFERENT */
  .diff-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-top:40px; }
  .diff-item { background:#fff; border-radius:var(--radius); padding:24px 26px; box-shadow:0 10px 30px -22px rgba(6,50,46,.3); display:flex; gap:16px; align-items:flex-start; }
  .diff-item .ico { flex:0 0 44px; height:44px; border-radius:12px; background:var(--foam); display:flex; align-items:center; justify-content:center; font-size:1.3rem; }
  .diff-item b { display:block; font-family:var(--font-display); font-size:1.06rem; margin-bottom:5px; }
  .diff-item p { font-size:.92rem; color:var(--ink-soft); }
  .diff-note { margin-top:24px; background:var(--sun-soft); border-left:4px solid var(--sun); border-radius:0 14px 14px 0; padding:18px 22px; font-size:.97rem; }

  /* CERTIFIED */
  .certified { background:var(--foam); }
  .cert-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin-top:38px; }
  .cert { background:#fff; border-radius:var(--radius); padding:28px 26px; box-shadow:0 10px 30px -22px rgba(6,50,46,.28); text-align:center; }
  .cert .ico { font-size:1.9rem; margin-bottom:10px; }
  .cert b { display:block; font-family:var(--font-display); font-size:1.1rem; margin-bottom:6px; }
  .cert p { font-size:.9rem; color:var(--ink-soft); }
  .cert-line { margin-top:26px; text-align:center; font-size:.98rem; color:var(--ink-soft); max-width:680px; margin-left:auto; margin-right:auto; }

  /* SAFETY */
  .safety-list { list-style:none; display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:38px; }
  .safety-list li { display:flex; gap:13px; align-items:flex-start; background:#fff; border-radius:14px; padding:18px 20px; box-shadow:0 8px 22px -18px rgba(6,50,46,.3); }
  .safety-list .ico { flex:0 0 40px; height:40px; border-radius:11px; background:var(--foam); display:flex; align-items:center; justify-content:center; font-size:1.15rem; }
  .safety-list b { display:block; }
  .safety-list span { font-size:.9rem; color:var(--ink-soft); }

  /* TESTIMONIALS */
  .testi-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin-top:42px; }
  .testi { background:#fff; border-radius:var(--radius); padding:26px; box-shadow:0 10px 30px -22px rgba(6,50,46,.3); }
  .testi .stars { color:var(--gold); font-size:.95rem; margin-bottom:10px; }
  .testi p { font-size:.95rem; color:var(--ink-soft); font-style:italic; }
  .testi footer { margin-top:14px; font-weight:700; font-size:.9rem; }
  .testi footer span { display:block; font-weight:500; color:var(--ink-soft); font-size:.8rem; font-family:var(--font-mono); }

  /* FAQ */
  .faq details { background:#fff; border-radius:14px; margin-bottom:12px; box-shadow:0 6px 18px -14px rgba(6,50,46,.3); overflow:hidden; }
  .faq summary { padding:20px 54px 20px 24px; font-weight:700; cursor:pointer; list-style:none; position:relative; font-size:1.02rem; }
  .faq summary::-webkit-details-marker { display:none; }
  .faq summary::after { content:"+"; position:absolute; right:22px; top:50%; transform:translateY(-50%); font-size:1.5rem; color:var(--sun); font-weight:400; transition:transform .2s; }
  .faq details[open] summary::after { transform:translateY(-50%) rotate(45deg); }
  .faq details p { padding:0 24px 22px; color:var(--ink-soft); font-size:.96rem; }

  /* CTA */
  .cta-box { background:radial-gradient(800px 360px at 18% 115%,rgba(255,107,61,.28),transparent 60%),linear-gradient(150deg,#06322E,#00897C); color:#fff; text-align:center; border-radius:var(--radius); padding:70px 30px; box-shadow:var(--shadow); }
  .cta-box h2 { color:#fff; margin-bottom:12px; }
  .cta-box p { color:rgba(255,255,255,.85); max-width:520px; margin:0 auto 28px; }
