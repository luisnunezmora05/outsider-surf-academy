---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData, ROUTES } from '../lib/seo'

const seo = seoData.groupLessons

const crumbs = [
  { name: 'Home', href: ROUTES.HOME },
  { name: 'Surf Lessons', href: ROUTES.SURF_LESSONS },
  { name: 'Group', href: ROUTES.GROUP },
]

const why = [
  { ico: '💸', b: 'The best price per person', p: 'Sharing an instructor keeps it affordable — the cheapest way to learn with us.' },
  { ico: '🤝', b: "It's social", p: 'Meet other travelers learning right alongside you. Wiping out together is a fast way to make friends.' },
  { ico: '👥', b: 'Still small, still personal', p: '"Group" doesn\'t mean a crowd. Max 4 students per instructor — never one of ten waiting for a turn.' },
  { ico: '😄', b: 'More fun for first-timers', p: "A relaxed group takes the pressure off. Everyone's a beginner, everyone's laughing, nobody's watching you." },
]

const perfectFor = [
  { ico: '🎒', b: 'Solo travelers', p: 'Meet people while learning something new.' },
  { ico: '💰', b: 'Backpackers & students', p: 'Keeping an eye on the budget.' },
  { ico: '😎', b: 'Easy-going first-timers', p: 'Who like a relaxed, social setting.' },
  { ico: '🧑‍🤝‍🧑', b: 'Small groups of friends', p: "Who don't mind a couple of other travelers." },
  { ico: '🏄', b: 'Anyone on a budget', p: 'The best-value way to try surfing.' },
]

const steps = [
  { n: '01', h: 'Meet your group & gear up', p: 'We introduce the group, check everyone\'s experience, and hand out boards and rash guards. The "strangers" already feel like teammates.' },
  { n: '02', h: 'Safety & sand (20 min)', p: 'Ocean safety, currents, right-of-way, and the basics — paddling, positioning and the pop-up, practiced on the sand.' },
  { n: '03', h: 'Catching waves together', p: 'Into the water as a group. Your instructor moves between you — and the whole group cheers when someone stands up.' },
  { n: '04', h: 'Feedback before you go', p: 'Quick, personal pointers for each of you. Many travelers book a second lesson on the spot.' },
]

const faqs = [
  { question: 'How much does a group surf lesson cost in Tamarindo?', answer: 'A group lesson starts at $50 per person — the most affordable way to learn to surf with us. That includes the board, rash guard, leash, wax, your bilingual instructor and session photos. No extra equipment fees at the beach.' },
  { question: 'How big is a group surf lesson?', answer: 'Smaller than you\'d expect — we cap group lessons at 4 students per instructor. "Group" never means a crowd here. A small ratio is the only way everyone actually catches waves and gets real coaching, instead of waiting while one instructor juggles ten beginners.' },
  { question: "Is a group surf lesson a good idea if I'm traveling alone?", answer: "It's one of the best things a solo traveler can do in Tamarindo. You're paired with other travelers at a similar level, so you learn alongside people in the same boat — and surfing together is a fast way to make friends. Plenty of solo surfers leave with a new crew and dinner plans." },
  { question: 'Will I be in a group with strangers, or just my friends?', answer: "In a group lesson you'll learn alongside other travelers — that's why it's the cheapest, most social option. But it stays small (max 4 per instructor) and we pair by level. If you'd rather keep it to just your own friends or family, that's our semi-private lesson instead." },
  { question: 'Are group surf lessons good for complete beginners?', answer: 'Yes — most people in a group lesson are complete beginners too. With a 4-to-1 ratio and groups paired by level, nobody gets left behind. Your instructor makes sure every person gets pushed into waves, not just the fast learners.' },
  { question: 'Can I book a group lesson for a bachelor party, family or company?', answer: "Absolutely — for 4 or more we arrange multiple instructors so everyone surfs at the same time, with a group rate. It's a top group activity in Tamarindo for bachelor and bachelorette parties, families, friends and company retreats. Message us with your numbers and dates and we'll build a custom plan." },
  { question: 'What time are group surf lessons in Tamarindo?', answer: "We run them daily, with start times through the day — typically 8am, 10am, 1pm and 3pm. We'll point you to the slot with the best tide for beginners that day, since that's when you'll catch the most waves. Message us and we'll confirm the next available time." },
  { question: "What's included in a group surf lesson?", answer: "Everything — a lower price doesn't mean less gear. Your lesson includes a soft-top board matched to your size, rash guard, leash, wax, your spot in a small group of max 4, session photos and a certified bilingual instructor. You just bring a swimsuit, reef-safe sunscreen and water." },
  { question: 'How long is a group surf lesson?', answer: 'About 90 minutes — it starts with a 15-minute safety-and-technique briefing on the sand, then the rest is in the water surfing. With our small group size, you spend most of those 90 minutes catching waves rather than waiting your turn.' },
  { question: 'Will I actually stand up in a group lesson, or is private better?', answer: 'Most people stand up and ride in their first group lesson — our small 4:1 ratio means your instructor gets everyone onto waves. A private lesson gives even more one-on-one attention if you\'re nervous, but for standing up on day one, a group lesson does the job for the great majority of beginners.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms} transparentNav={true}>
  <BreadcrumbSchema slot="head" items={crumbs} />
  <FAQSchema slot="head" items={faqs} />

  <div class="sl">

    <!-- ═══════════ HERO ═══════════ -->
    <header class="hero">
      <div class="hero-inner">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href={ROUTES.HOME}>Home</a> / <a href={ROUTES.SURF_LESSONS}>Surf Lessons</a> / Group
        </nav>
        <div class="hero-coords"><span class="dot"></span>Tamarindo · Guanacaste · Costa Rica</div>
        <h1>Group Surf Lessons in Tamarindo <span class="accent">— catch your first wave with new friends</span></h1>
        <p class="hero-sub">The social, budget-friendly way to learn. Join a small group of fellow travelers — never more than 4 per instructor — with all equipment included and the best price per person we offer.</p>
        <div class="hero-ctas">
          <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book From $50/person
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <div class="hero-rating"><span class="stars">★★★★★</span><span><b>Rated 5.0</b> on Google</span></div>
        </div>
      </div>
      <div class="hero-wave" aria-hidden="true"><svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0,36 C240,80 480,4 720,32 C960,60 1200,12 1440,44 L1440,80 L0,80 Z" fill="#06322E"/></svg></div>
    </header>

    <!-- ═══════════ BOOK BAND (flows out of the wave) ═══════════ -->
    <section class="bookband" aria-label="Group surf lesson at a glance">
      <div class="wrap">
        <div class="bookband-grid">
          <div class="bb-item"><div class="bb-k">Price</div><div class="bb-v">from $50 <small>/ person</small></div></div>
          <div class="bb-item"><div class="bb-k">Duration</div><div class="bb-v">~90 min</div></div>
          <div class="bb-item"><div class="bb-k">Group size</div><div class="bb-v">max 4 <small>per instructor</small></div></div>
          <div class="bb-item"><div class="bb-k">Daily times</div><div class="bb-v">8 · 10 · 1 · 3</div></div>
          <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book Now</a>
        </div>
      </div>
    </section>

    <!-- ═══════════ WHY ═══════════ -->
    <section id="why">
      <div class="wrap">
        <span class="eyebrow">Why Group</span>
        <h2>Why choose a group surf lesson?</h2>
        <p class="lead">If you're traveling solo or watching your budget, a group lesson is the way to go — the most popular entry point into surfing.</p>
        <div class="why-grid">
          {why.map(w => (
            <div class="why-item reveal"><div class="ico">{w.ico}</div><div><b>{w.b}</b><p>{w.p}</p></div></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ STRANGERS (key objection) ═══════════ -->
    <section class="strangers">
      <div class="wrap strangers-inner">
        <div>
          <span class="eyebrow gold">The Honest Answer</span>
          <h2>Will I be put in a group with strangers?</h2>
          <p>Yes — and that's kind of the point.</p>
          <p>In a group lesson you learn alongside other travelers, which is exactly why it costs less and why it's the most social option. But "group" here means small: a maximum of <strong>4 students per instructor</strong>. We also pair groups by experience, so you're with people at roughly your level — no advanced surfers leaving you behind.</p>
          <div class="tipbox">🍽️ Plenty of solo travelers book a group lesson and leave with a few new friends and a dinner plan. Want just your own crew instead? That's a <a href={ROUTES.SEMI_PRIVATE}>semi-private lesson</a>.</div>
        </div>
        <div class="strangers-card reveal">
          <div class="row"><div class="ic">👥</div><div><b>Max 4 per instructor</b><span>Small enough that everyone catches waves and gets real coaching.</span></div></div>
          <div class="row"><div class="ic">⚖️</div><div><b>Paired by level</b><span>You learn with people at your pace — nobody gets left behind.</span></div></div>
          <div class="row"><div class="ic">🎉</div><div><b>Social by design</b><span>The fun, low-pressure way to learn — and to meet other travelers.</span></div></div>
        </div>
      </div>
    </section>

    <!-- ═══════════ PERFECT FOR ═══════════ -->
    <section>
      <div class="wrap">
        <span class="eyebrow">Who It's For</span>
        <h2>Who group surf lessons are perfect for</h2>
        <div class="perfect-grid">
          {perfectFor.map(p => (
            <div class="pf reveal"><div class="ico">{p.ico}</div><b>{p.b}</b><p>{p.p}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ BIG GROUP ═══════════ -->
    <section class="biggroup" id="biggroup">
      <div class="wrap">
        <div class="biggroup-band reveal">
          <span class="eyebrow">Bigger Group? 4+ People</span>
          <h2>Bachelor parties, families, company retreats</h2>
          <p>Got a bigger crew? For groups of four or more, we arrange multiple instructors so everyone surfs at the same time — with a group rate to match. One of the best group activities in Tamarindo: easy to organize, all levels welcome, a story everyone goes home with.</p>
          <div class="chips">
            <span class="chip">Bachelor / bachelorette</span>
            <span class="chip">Families</span>
            <span class="chip">Company retreats</span>
            <span class="chip">Friend groups</span>
            <span class="chip">Organized tours</span>
          </div>
          <a href={ROUTES.CONTACT} class="lp-btn lp-btn-white">Message Us for Big Groups</a>
        </div>
      </div>
    </section>

    <!-- ═══════════ INCLUDED ═══════════ -->
    <section class="included" id="included">
      <div class="wrap">
        <span class="eyebrow">What's Included</span>
        <h2>A lower price, but never less gear</h2>
        <p class="lead">Every group lesson includes everything you need to surf.</p>
        <div class="inc-grid">
          <ul class="inc-list reveal">
            <li><span class="ck">✓</span><div><b>A certified bilingual instructor</b><span>English / Spanish</span></div></li>
            <li><span class="ck">✓</span><div><b>A soft-top surfboard</b><span>Matched to your size and level</span></div></li>
            <li><span class="ck">✓</span><div><b>Rash guard, leash &amp; wax</b><span>Ready before you arrive</span></div></li>
            <li><span class="ck">✓</span><div><b>Your spot in a small group</b><span>Capped at 4 per instructor</span></div></li>
            <li><span class="ck">✓</span><div><b>Session photos</b><span>To take home</span></div></li>
          </ul>
          <aside class="inc-aside reveal">
            <h3>Just bring</h3>
            <p>A swimsuit, reef-safe sunscreen and water. Leave valuables at your hotel — you'll be in the ocean the whole time.</p>
            <span class="tag">Lessons run ~90 min</span>
            <p style="margin-top:14px">A 20-minute safety-and-technique session on the sand, then the rest in the water with your instructor coaching the group.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ═══════════ STEPS ═══════════ -->
    <section class="steps" id="steps">
      <div class="wrap">
        <span class="eyebrow">How It Works</span>
        <h2>Your group surf lesson, step by step</h2>
        <p class="lead">Here's exactly how your 90 minutes flow, so you know what to expect before you arrive.</p>
        <div class="steps-grid">
          {steps.map(s => (
            <div class="step reveal"><div class="num">{s.n}</div><h3>{s.h}</h3><p>{s.p}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ COMPARE 3-WAY ═══════════ -->
    <section class="compare">
      <div class="wrap">
        <span class="eyebrow">Which to Pick</span>
        <h2>Group vs semi-private vs private</h2>
        <p class="lead">Three formats, three different vibes. Here's the honest rundown.</p>
        <div class="cmp-grid">
          <div class="cmp is-group reveal">
            <span class="badge">You're here</span>
            <span class="tag">Group · from $50</span>
            <h3>Most social &amp; best value</h3>
            <p>A small group of up to 4 that may include other travelers. Best for solo travelers, backpackers and the budget-conscious.</p>
          </div>
          <div class="cmp reveal">
            <span class="tag tag-teal">Semi-private · from $65</span>
            <h3>Just your own crew</h3>
            <p>Your group of 2–3, no strangers, more personal attention. Best for couples and friends.</p>
            <a href={ROUTES.SEMI_PRIVATE}>See semi-private →</a>
          </div>
          <div class="cmp reveal">
            <span class="tag tag-teal">Private · from $80</span>
            <h3>Fastest progress</h3>
            <p>One-on-one, the most reassuring if you're nervous or short on time.</p>
            <a href={ROUTES.PRIVATE}>See private →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ GUARANTEE ═══════════ -->
    <!-- TODO: confirm the "stand up or next lesson free" guarantee terms with the client before going live -->
    <section class="guarantee">
      <div class="wrap">
        <div class="guarantee-box reveal">
          <span class="eyebrow gold center">Our Promise</span>
          <h2>Stand up on your first lesson — guaranteed</h2>
          <p>If you don't stand up and ride a wave in your first lesson, your next one is on us. Even in a group, our small ratio means your instructor gets everyone onto waves — standing up on day one is the rule here, not the exception.</p>
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIALS ═══════════ -->
    <section class="testimonials">
      <div class="wrap">
        <span class="eyebrow">Reviews</span>
        <h2>What our students say</h2>
        <div class="testi-grid">
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"Booked a group lesson solo and ended up surfing with three other travelers — we all stood up, cheered each other on, and got dinner together after. Best afternoon of my trip."</p><footer>Jake M.<span>Seattle, USA · Google</span></footer></div>
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"Backpacking on a budget and this was such great value. Only four of us with one instructor, so I got real coaching — not a crowded beach. Stood up on my second wave!"</p><footer>Sophie L.<span>London, UK · Google</span></footer></div>
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"Did the group lesson with a few friends. Relaxed, fun and the instructor made sure every single one of us caught waves. Can't recommend Outsider enough."</p><footer>Carlos R.<span>Toronto, Canada · Google</span></footer></div>
        </div>
        <!-- TODO: point to your Google Business reviews URL -->
        <p style="text-align:center;margin-top:28px"><a href="#" class="lp-btn lp-btn-line">Read all reviews on Google</a></p>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section class="faq" id="faq">
      <div class="wrap-narrow">
        <span class="eyebrow">FAQ</span>
        <h2>Group surf lesson FAQs</h2>
        <div style="margin-top:34px">
          {faqs.map(f => (
            <details class="reveal"><summary>{f.question}</summary><p>{f.answer}</p></details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA ═══════════ -->
    <section class="cta" id="book">
      <div class="wrap">
        <div class="cta-box reveal">
          <h2>Book your group surf lesson in Tamarindo</h2>
          <p>Grab a spot, meet some people, and catch your first wave. Book online in two minutes, or message us on WhatsApp — and if you're a bigger group, tell us and we'll sort it out.</p>
          <div class="cta-ctas">
            <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book Now</a>
            <a href={ROUTES.CONTACT} class="lp-btn lp-btn-white">Message us on WhatsApp</a>
          </div>
          <address>📍 Tamarindo Beach, Guanacaste, Costa Rica</address>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Group surf lessons — scoped local styles, reusing the global Outsider
     palette tokens defined in global.css. Ported from the approved prototype. */
  .sl { --teal-light:#5FD3C6; }
  .sl :global(*) { box-sizing:border-box; }

  .wrap { max-width:1120px; margin:0 auto; padding:0 24px; }
  .wrap-narrow { max-width:860px; margin:0 auto; padding:0 24px; }
  .sl section { padding:84px 0; }

  .eyebrow { display:inline-flex; align-items:center; gap:.6rem; font-family:var(--font-mono); font-size:.72rem; letter-spacing:.18em; text-transform:uppercase; color:var(--teal-deep); margin-bottom:14px; }
  .eyebrow::before { content:""; width:22px; height:1.5px; background:var(--sun); }
  .eyebrow.gold { color:var(--gold); }
  .eyebrow.gold::before { background:var(--gold); }
  .eyebrow.center { justify-content:center; }
  .lead { color:var(--ink-soft); max-width:660px; margin-top:14px; }

  .lp-btn { display:inline-flex; align-items:center; gap:9px; padding:15px 28px; border-radius:999px; font-weight:700; font-size:1rem; text-decoration:none; cursor:pointer; border:none; font-family:var(--font-body); transition:transform .18s ease,box-shadow .18s ease; }
  .lp-btn:hover { transform:translateY(-2px); }
  .lp-btn svg { width:16px; height:16px; }
  .lp-btn-sun { background:var(--sun); color:#fff; box-shadow:0 14px 28px -12px rgba(255,107,61,.5); }
  .lp-btn-line { background:transparent; color:var(--ink); border:2px solid rgba(6,50,46,.2); }
  .lp-btn-line:hover { border-color:var(--ink); }
  .lp-btn-white { background:#fff; color:var(--teal-deep); }

  /* HERO */
  .hero { position:relative; overflow:hidden; color:#fff;
    background:radial-gradient(1100px 480px at 82% -12%,rgba(255,107,61,.22),transparent 58%),
    linear-gradient(160deg,#04413B 0%,#06322E 30%,#00897C 72%,#00B4A2 105%); }
  .hero-inner { max-width:1120px; margin:0 auto; padding:120px 24px 138px; position:relative; z-index:2; }
  .crumb { font-family:var(--font-mono); font-size:.72rem; color:rgba(255,255,255,.7); margin-bottom:18px; letter-spacing:.04em; }
  .crumb a { color:rgba(255,255,255,.7); text-decoration:none; }
  .crumb a:hover { color:#fff; }
  .hero-coords { display:inline-flex; align-items:center; gap:9px; font-family:var(--font-mono); font-size:.74rem; letter-spacing:.1em; text-transform:uppercase; color:rgba(255,255,255,.82); margin-bottom:20px; }
  .hero-coords .dot { width:8px; height:8px; border-radius:50%; background:var(--gold); box-shadow:0 0 0 4px rgba(255,201,92,.25); }
  .hero h1 { font-family:var(--font-display); font-size:clamp(2.2rem,5vw,3.6rem); font-weight:600; line-height:1.12; letter-spacing:-.01em; max-width:800px; color:#fff; }
  .hero h1 .accent { color:var(--gold); font-style:italic; font-weight:500; }
  .hero-sub { margin:22px 0 32px; font-size:1.12rem; max-width:600px; color:rgba(255,255,255,.88); }
  .hero-ctas { display:flex; gap:14px; flex-wrap:wrap; align-items:center; }
  .hero-rating { display:flex; align-items:center; gap:9px; font-size:.92rem; color:rgba(255,255,255,.9); margin-left:4px; }
  .hero-rating .stars { color:var(--gold); letter-spacing:1px; }
  .hero-wave { position:absolute; bottom:-1px; left:0; width:100%; line-height:0; z-index:1; }
  .hero-wave svg { width:100%; height:80px; display:block; }

  /* BOOK BAND — flows straight out of the dark hero wave (4 data points) */
  .bookband { background:var(--ink); position:relative; z-index:2; }
  .sl section.bookband { padding:2.6rem 0 3rem; }
  .bookband-grid { display:grid; grid-template-columns:repeat(4,1fr) auto; align-items:center; gap:2rem; }
  .bb-item { position:relative; }
  .bb-item + .bb-item::before { content:''; position:absolute; left:-1rem; top:50%; transform:translateY(-50%); width:1px; height:42px; background:rgba(247,242,234,.16); }
  .bb-k { font-family:var(--font-mono); font-size:.66rem; text-transform:uppercase; letter-spacing:.09em; color:rgba(247,242,234,.6); }
  .bb-v { font-family:var(--font-display); font-size:1.4rem; color:#fff; margin-top:4px; }
  .bb-v small { font-family:var(--font-body); font-size:.74rem; color:rgba(247,242,234,.6); font-weight:600; }
  .bookband-grid .lp-btn { justify-self:end; }

  /* WHY */
  .why-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-top:40px; }
  .why-item { background:#fff; border-radius:var(--radius); padding:24px 26px; box-shadow:0 10px 30px -22px rgba(6,50,46,.3); display:flex; gap:16px; align-items:flex-start; }
  .why-item .ico { flex:0 0 44px; height:44px; border-radius:12px; background:var(--foam); display:flex; align-items:center; justify-content:center; font-size:1.3rem; }
  .why-item b { display:block; font-family:var(--font-display); font-size:1.08rem; margin-bottom:5px; }
  .why-item p { font-size:.93rem; color:var(--ink-soft); }

  /* STRANGERS (dark highlight) */
  .strangers { background:var(--ink); color:#fff; }
  .strangers-inner { display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center; }
  .strangers h2 { color:#fff; }
  .strangers p { color:rgba(255,255,255,.82); margin-top:14px; }
  .strangers p + p { margin-top:14px; }
  .strangers .tipbox { background:var(--sun-soft); border-radius:14px; padding:18px 22px; margin-top:18px; color:var(--ink); font-size:.95rem; }
  .strangers .tipbox a { color:var(--teal-deep); font-weight:700; }
  .strangers-card { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.13); border-radius:var(--radius); padding:28px; }
  .strangers-card .row { display:flex; gap:14px; align-items:flex-start; margin-bottom:16px; }
  .strangers-card .row:last-child { margin-bottom:0; }
  .strangers-card .ic { flex:0 0 40px; height:40px; border-radius:11px; background:var(--teal); display:flex; align-items:center; justify-content:center; font-size:1.1rem; }
  .strangers-card b { display:block; color:#fff; }
  .strangers-card span { font-size:.9rem; color:rgba(255,255,255,.72); }

  /* PERFECT FOR */
  .perfect-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:16px; margin-top:40px; }
  .pf { background:#fff; border-radius:var(--radius); padding:22px 18px; box-shadow:0 10px 30px -22px rgba(6,50,46,.28); text-align:center; }
