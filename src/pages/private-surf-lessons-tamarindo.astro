---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import BreadcrumbSchema from '../components/seo/BreadcrumbSchema.astro'
import { seoData, ROUTES } from '../lib/seo'

const seo = seoData.privateLessons

const crumbs = [
  { name: 'Home', href: ROUTES.HOME },
  { name: 'Surf Lessons', href: ROUTES.SURF_LESSONS },
  { name: 'Private', href: ROUTES.PRIVATE },
]

const why = [
  { ico: '🎯', b: '100% of the attention', p: 'Every correction, every wave, focused on you. No splitting time with other students.' },
  { ico: '⚡', b: 'Faster progress', p: 'Someone reading the waves and pushing you into the right ones means more waves per hour — and more standing up.' },
  { ico: '🐢', b: "Your pace, not the group's", p: 'Nervous? Take it slow. Confident? Push harder. The lesson bends entirely to you.' },
  { ico: '🗓️', b: 'Flexible scheduling', p: "Easiest lesson to fit around your vacation plans and the day's best tide window." },
]

const perfectFor = [
  { ico: '😅', b: 'Nervous first-timers', p: 'No group, no audience. Just you and a patient instructor.' },
  { ico: '⏱️', b: 'Short on time', p: 'One focused lesson beats a couple of crowded ones.' },
  { ico: '🙆', b: 'Over 40 / taking it easy', p: 'Set your own rhythm without holding anyone up.' },
  { ico: '📈', b: 'Improvers', p: 'Fix your pop-up, paddling or wave-reading, one-on-one.' },
  { ico: '👨‍👧', b: 'Parent + one child', p: "Learn side by side with the instructor's full focus." },
]

const steps = [
  { n: '01', h: 'Meet & gear up', p: 'We get to know your experience and goals, and fit your board and rash guard. The lesson is tailored from minute one.' },
  { n: '02', h: 'Safety & sand practice', p: 'Ocean safety, currents, right-of-way and the pop-up — practiced on the sand until it feels natural. No rushing to keep up.' },
  { n: '03', h: 'One-on-one in the water', p: 'Your instructor reads the waves, pushes you into the good ones, and corrects you in real time — wave after wave, all yours.' },
  { n: '04', h: 'Feedback to take home', p: 'Exactly what you nailed and what to work on next. Book again, and we pick up right where you left off.' },
]

const faqs = [
  { question: 'Is a private surf lesson worth it for a beginner?', answer: "For a lot of beginners, yes — especially if you're nervous or short on time. Your instructor is focused only on you, so you catch more waves, get corrected on every one, and progress faster than sharing an instructor with a group. If your goal is to stand up on day one, private is the surest way there." },
  { question: 'How much does a private surf lesson in Tamarindo cost?', answer: 'A private one-on-one lesson starts at $80 per person, and that includes the board, rash guard, leash, wax, your dedicated bilingual instructor and session photos — no extra equipment fees added at the beach.' },
  { question: "What's the difference between a private and a group surf lesson?", answer: 'Attention. In a private lesson, one instructor works only with you, so the pace and focus are yours. In a group lesson (capped at 4 students) you share the instructor and the pace is set for everyone. Private costs more but gets you further faster; group is more social and budget-friendly.' },
  { question: "I'm in my 40s/50s and nervous — is private a good idea?", answer: "Probably the best choice for you. A big share of our private lessons are travelers in their 40s and 50s who'd rather learn at their own pace than keep up with a group. You set the rhythm, there's no audience, and most of these students stand up and ride a wave in their very first lesson." },
  { question: 'Can a couple take a private lesson together?', answer: "If two of you want to share one instructor, that's really our semi-private lesson — same personal feel, lower price per person. A true private lesson is one-on-one. Tell us who's coming and we'll point you to the right fit." },
  { question: 'Will I actually stand up during a private lesson?', answer: "Almost certainly — private gives you the best odds of anyone. With your instructor focused entirely on you, timing the lesson to the calmest part of the day and pushing you into the right waves, standing up on your first private lesson is the rule, not the exception. And if you don't, your next lesson is on us." },
  { question: 'I already surf a little — can a private lesson help me improve?', answer: "Yes, and it's one of the best uses of private. If you can stand up but want to fix your pop-up, paddle better, read waves or start turning, your instructor spends the whole lesson on those specific things instead of re-teaching basics. The fastest way to break a plateau." },
  { question: 'How long is a private lesson, and how many waves will I catch?', answer: 'About 2 hours — a short briefing on the sand, then the rest in the water. Because no one shares your instructor, you spend almost all that water time actually surfing, so you will catch noticeably more waves than in a group lesson of the same length.' },
  { question: 'Can I book a private lesson for the same day in Tamarindo?', answer: "Often yes — private lessons are the easiest to fit in on short notice, since we just match you with one available instructor and a good tide window. Message us on WhatsApp and we'll tell you the soonest slot. In high season (December–April), booking a day ahead is safer for the best tides." },
  { question: 'Do you offer private lessons for kids?', answer: "Yes — private is a great option for younger kids who do better one-on-one than in a group. We teach kids from age 6, always in shallow, sandy-bottom water with the instructor within arm's reach and focused entirely on keeping them safe and getting them standing up." },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms} transparentNav={true}>
  <BreadcrumbSchema slot="head" items={crumbs} />
  <FAQSchema slot="head" items={faqs} />

  <div class="sl">

    <!-- ═══════════ HERO ═══════════ -->
    <header class="hero">
      <div class="hero-inner">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href={ROUTES.HOME}>Home</a> / <a href={ROUTES.SURF_LESSONS}>Surf Lessons</a> / Private
        </nav>
        <div class="hero-coords"><span class="dot"></span>Tamarindo · Guanacaste · Costa Rica</div>
        <h1>Private Surf Lessons in Tamarindo <span class="accent">— just you and the next wave</span></h1>
        <p class="hero-sub">The fastest, most comfortable way to learn: one-on-one coaching at your own pace, all equipment included. Perfect for first-timers who want full attention — and surfers polishing a specific skill.</p>
        <div class="hero-ctas">
          <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book Your Private Lesson
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <div class="hero-rating"><span class="stars">★★★★★</span><span><b>Rated 5.0</b> on Google</span></div>
        </div>
      </div>
      <div class="hero-wave" aria-hidden="true"><svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0,36 C240,80 480,4 720,32 C960,60 1200,12 1440,44 L1440,80 L0,80 Z" fill="#06322E"/></svg></div>
    </header>

    <!-- ═══════════ BOOK BAND (flows out of the wave) ═══════════ -->
    <section class="bookband" aria-label="Private surf lesson at a glance">
      <div class="wrap">
        <div class="bookband-grid">
          <div class="bb-item"><div class="bb-k">Price</div><div class="bb-v">from $80 <small>/ person</small></div></div>
          <div class="bb-item"><div class="bb-k">Duration</div><div class="bb-v">~2 hours</div></div>
          <div class="bb-item"><div class="bb-k">Ratio</div><div class="bb-v">1-on-1</div></div>
          <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book Now</a>
        </div>
      </div>
    </section>

    <!-- ═══════════ WHY PRIVATE ═══════════ -->
    <section id="why">
      <div class="wrap">
        <span class="eyebrow">Why Private</span>
        <h2>Why choose a private surf lesson?</h2>
        <p class="lead">If you want to learn as fast as possible — or you're nervous about your first time — private is the way to do it. Here's what one-on-one gets you.</p>
        <div class="why-grid">
          {why.map(w => (
            <div class="why-item reveal"><div class="ico">{w.ico}</div><div><b>{w.b}</b><p>{w.p}</p></div></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ COMPARE ═══════════ -->
    <section class="compare">
      <div class="wrap">
        <span class="eyebrow">Private vs Group</span>
        <h2>Is a private lesson worth it vs a group lesson?</h2>
        <p class="lead">Honest answer: it depends on what you want. There's no wrong choice — just different goals.</p>
        <div class="compare-box reveal">
          <div class="compare-row">
            <div class="compare-col is-private">
              <span class="tag">Private · from $80</span>
              <h3>Worth it for progress &amp; comfort</h3>
              <p>You'll improve faster and feel more at ease — especially if you're nervous, short on time, or learning later in life. Most first-timers who choose private tell us the personal attention was worth every dollar.</p>
            </div>
            <div class="compare-col">
              <span class="tag tag-teal">Group · from $50</span>
              <h3>Better for budget &amp; social vibe</h3>
              <p>The right pick if you're watching your budget or you want to meet other travelers and don't mind sharing your instructor. Small groups, capped at 4 students.</p>
              <a href={ROUTES.GROUP}>Compare group lessons →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ PERFECT FOR ═══════════ -->
    <section>
      <div class="wrap">
        <span class="eyebrow">Who It's For</span>
        <h2>Who private surf lessons are perfect for</h2>
        <div class="perfect-grid">
          {perfectFor.map(p => (
            <div class="pf reveal"><div class="ico">{p.ico}</div><b>{p.b}</b><p>{p.p}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ INCLUDED ═══════════ -->
    <section class="included" id="included">
      <div class="wrap">
        <span class="eyebrow gold">What's Included</span>
        <h2>Everything's included in your private lesson</h2>
        <p class="lead">No hidden fees, no equipment rentals sprung on you at the beach.</p>
        <div class="inc-grid">
          <ul class="inc-list reveal">
            <li><span class="ck">✓</span><div><b>A dedicated bilingual instructor</b><span>English / Spanish — yours alone for the full lesson</span></div></li>
            <li><span class="ck">✓</span><div><b>Soft-top surfboard</b><span>Matched to your height, weight and level</span></div></li>
            <li><span class="ck">✓</span><div><b>Rash guard, leash &amp; wax</b><span>Set up and ready before you arrive</span></div></li>
            <li><span class="ck">✓</span><div><b>Tide-timed scheduling</b><span>Your lesson at the day's best window</span></div></li>
            <li><span class="ck">✓</span><div><b>Session photos</b><span>Proof you caught a wave, to take home</span></div></li>
          </ul>
          <aside class="inc-aside reveal">
            <h3>Just bring</h3>
            <p>A swimsuit, reef-safe sunscreen and a bottle of water. Leave valuables at your hotel — you'll be in the ocean the whole time.</p>
            <span class="tag">Lessons run ~2 hours</span>
            <p style="margin-top:14px">A short safety-and-technique session on the sand, then the rest in the water, surfing with your coach beside you.</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- ═══════════ STEPS ═══════════ -->
    <section class="steps" id="steps">
      <div class="wrap">
        <span class="eyebrow">How It Works</span>
        <h2>Your private lesson, step by step</h2>
        <p class="lead">The beauty of private is that the whole thing moves at your speed. Here's how your two hours flow.</p>
        <div class="steps-grid">
          {steps.map(s => (
            <div class="step reveal"><div class="num">{s.n}</div><h3>{s.h}</h3><p>{s.p}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ GUARANTEE ═══════════ -->
    <!-- TODO: confirm the "stand up or next lesson free" guarantee terms with the client before going live -->
    <section class="guarantee">
      <div class="wrap">
        <div class="guarantee-box reveal">
          <span class="eyebrow gold center">Our Promise</span>
          <h2>Stand up on your first private lesson — guaranteed</h2>
          <p>If you don't stand up and ride a wave in your first private lesson, your next one is on us. With an instructor focused only on you, standing up on day one isn't luck — it's the plan.</p>
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIALS ═══════════ -->
    <section class="testimonials">
      <div class="wrap">
        <span class="eyebrow">Reviews</span>
        <h2>What our private lesson students say</h2>
        <div class="testi-grid">
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"Never touched a board in my life and I was terrified. My instructor was so patient — by the end I was riding waves on my own. The one-on-one made all the difference."</p><footer>Jake M.<span>Seattle, USA · Google</span></footer></div>
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"Booked a private to fix my pop-up after years of bad habits. Two hours and my whole stance changed. Worth every penny to have someone watching only me."</p><footer>Sophie L.<span>London, UK · Google</span></footer></div>
          <div class="testi reveal"><div class="stars">★★★★★</div><p>"I'm 52 and didn't want to hold a group back. Private let me go at my own pace and I stood up on my first lesson. Genuinely the highlight of our Costa Rica trip."</p><footer>Carlos R.<span>Toronto, Canada · Google</span></footer></div>
        </div>
        <!-- TODO: point to your Google Business reviews URL -->
        <p style="text-align:center;margin-top:28px"><a href="#" class="lp-btn lp-btn-line">Read all reviews on Google</a></p>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section class="faq" id="faq">
      <div class="wrap-narrow">
        <span class="eyebrow">FAQ</span>
        <h2>Private surf lesson FAQs</h2>
        <div style="margin-top:34px">
          {faqs.map(f => (
            <details class="reveal"><summary>{f.question}</summary><p>{f.answer}</p></details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ CTA ═══════════ -->
    <section class="cta" id="book">
      <div class="wrap">
        <div class="cta-box reveal">
          <h2>Book your private surf lesson in Tamarindo</h2>
          <p>The waves are waiting, and so is your instructor. Book online in two minutes, or message us on WhatsApp — we reply fast.</p>
          <div class="cta-ctas">
            <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book Now</a>
            <a href={ROUTES.CONTACT} class="lp-btn lp-btn-white">Message us on WhatsApp</a>
          </div>
          <address>📍 Tamarindo Beach, Guanacaste, Costa Rica</address>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Private surf lessons — scoped local styles, reusing the global Outsider
     palette tokens defined in global.css. Ported from the approved prototype. */
  .sl { --teal-light:#5FD3C6; }
  .sl :global(*) { box-sizing:border-box; }

  .wrap { max-width:1120px; margin:0 auto; padding:0 24px; }
  .wrap-narrow { max-width:860px; margin:0 auto; padding:0 24px; }
  .sl section { padding:84px 0; }

  .eyebrow { display:inline-flex; align-items:center; gap:.6rem; font-family:var(--font-mono); font-size:.72rem; letter-spacing:.18em; text-transform:uppercase; color:var(--teal-deep); margin-bottom:14px; }
  .eyebrow::before { content:""; width:22px; height:1.5px; background:var(--sun); }
  .eyebrow.gold { color:var(--gold); }
  .eyebrow.gold::before { background:var(--gold); }
  .eyebrow.center { justify-content:center; }
  .lead { color:var(--ink-soft); max-width:660px; margin-top:14px; }

  .lp-btn { display:inline-flex; align-items:center; gap:9px; padding:15px 28px; border-radius:999px; font-weight:700; font-size:1rem; text-decoration:none; cursor:pointer; border:none; font-family:var(--font-body); transition:transform .18s ease,box-shadow .18s ease; }
  .lp-btn:hover { transform:translateY(-2px); }
  .lp-btn svg { width:16px; height:16px; }
  .lp-btn-sun { background:var(--sun); color:#fff; box-shadow:0 14px 28px -12px rgba(255,107,61,.5); }
  .lp-btn-line { background:transparent; color:var(--ink); border:2px solid rgba(6,50,46,.2); }
  .lp-btn-line:hover { border-color:var(--ink); }
  .lp-btn-white { background:#fff; color:var(--teal-deep); }

  /* HERO */
  .hero { position:relative; overflow:hidden; color:#fff;
    background:radial-gradient(1100px 480px at 82% -12%,rgba(255,107,61,.22),transparent 58%),
    linear-gradient(160deg,#04413B 0%,#06322E 30%,#00897C 72%,#00B4A2 105%); }
  .hero-inner { max-width:1120px; margin:0 auto; padding:120px 24px 138px; position:relative; z-index:2; }
  .crumb { font-family:var(--font-mono); font-size:.72rem; color:rgba(255,255,255,.7); margin-bottom:18px; letter-spacing:.04em; }
  .crumb a { color:rgba(255,255,255,.7); text-decoration:none; }
  .crumb a:hover { color:#fff; }
  .hero-coords { display:inline-flex; align-items:center; gap:9px; font-family:var(--font-mono); font-size:.74rem; letter-spacing:.1em; text-transform:uppercase; color:rgba(255,255,255,.82); margin-bottom:20px; }
  .hero-coords .dot { width:8px; height:8px; border-radius:50%; background:var(--gold); box-shadow:0 0 0 4px rgba(255,201,92,.25); }
  .hero h1 { font-family:var(--font-display); font-size:clamp(2.2rem,5vw,3.6rem); font-weight:600; line-height:1.12; letter-spacing:-.01em; max-width:780px; color:#fff; }
  .hero h1 .accent { color:var(--gold); font-style:italic; font-weight:500; }
  .hero-sub { margin:22px 0 32px; font-size:1.12rem; max-width:600px; color:rgba(255,255,255,.88); }
  .hero-ctas { display:flex; gap:14px; flex-wrap:wrap; align-items:center; }
  .hero-rating { display:flex; align-items:center; gap:9px; font-size:.92rem; color:rgba(255,255,255,.9); margin-left:4px; }
  .hero-rating .stars { color:var(--gold); letter-spacing:1px; }
  .hero-wave { position:absolute; bottom:-1px; left:0; width:100%; line-height:0; z-index:1; }
  .hero-wave svg { width:100%; height:80px; display:block; }

  /* BOOK BAND — flows straight out of the dark hero wave */
  .bookband { background:var(--ink); position:relative; z-index:2; }
  .sl section.bookband { padding:2.6rem 0 3rem; }
  .bookband-grid { display:grid; grid-template-columns:repeat(3,1fr) auto; align-items:center; gap:2.5rem; }
  .bb-item { position:relative; }
  .bb-item + .bb-item::before { content:''; position:absolute; left:-1.25rem; top:50%; transform:translateY(-50%); width:1px; height:42px; background:rgba(247,242,234,.16); }
  .bb-k { font-family:var(--font-mono); font-size:.68rem; text-transform:uppercase; letter-spacing:.1em; color:rgba(247,242,234,.6); }
  .bb-v { font-family:var(--font-display); font-size:1.5rem; color:#fff; margin-top:4px; }
  .bb-v small { font-family:var(--font-body); font-size:.78rem; color:rgba(247,242,234,.6); font-weight:600; }
  .bookband-grid .lp-btn { justify-self:end; }

  /* WHY PRIVATE */
  .why-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-top:40px; }
  .why-item { background:#fff; border-radius:var(--radius); padding:24px 26px; box-shadow:0 10px 30px -22px rgba(6,50,46,.3); display:flex; gap:16px; align-items:flex-start; }
  .why-item .ico { flex:0 0 44px; height:44px; border-radius:12px; background:var(--foam); display:flex; align-items:center; justify-content:center; font-size:1.3rem; }
  .why-item b { display:block; font-family:var(--font-display); font-size:1.08rem; margin-bottom:5px; }
  .why-item p { font-size:.93rem; color:var(--ink-soft); }

  /* COMPARE */
  .compare { background:var(--sand-deep); }
  .compare-box { background:#fff; border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow); margin-top:32px; }
  .compare-row { display:grid; grid-template-columns:1fr 1fr; gap:0; }
  .compare-col { padding:30px 32px; }
  .compare-col + .compare-col { border-left:1px solid rgba(6,50,46,.1); }
  .compare-col.is-private { background:var(--foam); }
  .compare-col h3 { font-family:var(--font-display); font-size:1.15rem; margin-bottom:6px; }
  .compare-col .tag { font-family:var(--font-mono); font-size:.7rem; text-transform:uppercase; letter-spacing:.08em; color:var(--sun); font-weight:700; }
  .compare-col .tag-teal { color:var(--teal-deep); }
  .compare-col p { font-size:.94rem; color:var(--ink-soft); margin-top:10px; }
  .compare-col a { color:var(--teal-deep); font-weight:700; text-decoration:none; font-size:.92rem; display:inline-block; margin-top:12px; }
  .compare-col a:hover { text-decoration:underline; }

  /* PERFECT FOR */
  .perfect-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:16px; margin-top:40px; }
  .pf { background:#fff; border-radius:var(--radius); padding:22px 18px; box-shadow:0 10px 30px -22px rgba(6,50,46,.28); text-align:center; }
  .pf .ico { font-size:1.7rem; margin-bottom:10px; }
  .pf b { display:block; font-family:var(--font-display); font-size:.98rem; margin-bottom:6px; }
  .pf p { font-size:.84rem; color:var(--ink-soft); }

  /* INCLUDED */
  .included { background:var(--ink); color:#fff; }
  .included h2 { color:#fff; }
  .included .lead { color:rgba(255,255,255,.74); }
  .inc-grid { display:grid; grid-template-columns:1.2fr 1fr; gap:50px; margin-top:40px; align-items:start; }
  .inc-list { list-style:none; display:grid; gap:16px; }
  .inc-list li { display:flex; gap:14px; align-items:flex-start; }
  .inc-list .ck { flex:0 0 26px; height:26px; border-radius:8px; background:var(--teal); display:flex; align-items:center; justify-content:center; font-size:.8rem; font-weight:800; color:#06322E; }
  .inc-list b { display:block; font-size:.98rem; }
  .inc-list span { font-size:.9rem; color:rgba(255,255,255,.72); }
  .inc-aside { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.13); border-radius:var(--radius); padding:26px; }
  .inc-aside h3 { font-family:var(--font-display); color:var(--gold); font-size:1.05rem; margin-bottom:10px; }
  .inc-aside p { font-size:.93rem; color:rgba(255,255,255,.8); margin-bottom:12px; }
  .inc-aside .tag { display:inline-block; font-family:var(--font-mono); font-size:.74rem; background:rgba(255,201,92,.15); color:var(--gold); padding:5px 11px; border-radius:999px; }

  /* STEPS */
  .steps { background:var(--foam); }
  .steps-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; margin-top:42px; }
  .step { background:#fff; border-radius:var(--radius); padding:24px 22px; box-shadow:0 10px 30px -22px rgba(6,50,46,.25); }
  .step .num { font-family:var(--font-mono); font-size:.8rem; color:var(--sun); font-weight:700; }
  .step h3 { font-family:var(--font-display); font-size:1.02rem; margin:8px 0; }
  .step p { font-size:.88rem; color:var(--ink-soft); }

  /* GUARANTEE */
  .guarantee { text-align:center; }
