---
export const prerender = true
import BaseLayout from '../layouts/BaseLayout.astro'
import FAQSchema from '../components/seo/FAQSchema.astro'
import { seoData, ROUTES } from '../lib/seo'

const seo = seoData.home

const faqs = [
  { question: 'What’s the best surf school in Tamarindo for complete beginners?', answer: 'Look for three things: small groups, instructors in the water with you, and lessons scheduled around the tide. At Outsider Surf Academy we built our school around those three — groups capped at 4 students per instructor, your instructor next to you the entire lesson, and sessions booked for the best tide window of your day. Most first-timers stand up within their first lesson.' },
  { question: 'How much do surf lessons cost in Tamarindo, Costa Rica?', answer: 'In Tamarindo, lessons typically run $45–$90 per person. At Outsider Surf Academy, group lessons start at $50 per person, semi-private at $65, and private lessons at $80. Every lesson includes the board, rash guard, leash, wax and a bilingual instructor — no extra equipment fees.' },
  { question: 'I’m in my 40s and not in great shape. Can I still learn to surf?', answer: 'Yes — honestly, a big part of the people we teach are between 30 and 50, on vacation, and haven’t exercised much lately. You learn in waist-deep water, the instructor pushes you into waves so you’re not exhausting yourself paddling, and we go at your pace. If you can get up off the floor, you can learn to surf.' },
  { question: 'Is Tamarindo safe for learning to surf?', answer: 'Tamarindo is one of the safest beaches in Costa Rica to learn: sandy bottom, warm water year-round, and gentle waves in waist-deep water. We add our own layer: morning condition checks, a safety briefing before every lesson, and if conditions aren’t right for beginners, we reschedule — no exceptions.' },
  { question: 'Can my kids take surf lessons? What’s the minimum age?', answer: 'We teach kids from age 6, and parents can join the same lesson. Kids always surf in shallow water with an instructor within arm’s reach, on big stable soft-top boards. Fair warning: your kids will probably stand up before you do.' },
  { question: 'Do I need to book in advance, or can I just show up?', answer: 'You can book online in about two minutes, or message us on WhatsApp. In high season (December–April) we recommend booking 1–2 days ahead, because the best tide slots fill first. Already in Tamarindo and want to surf today? Message us anyway — if there’s space in a good window, you’re in.' },
  { question: 'What happens if it rains on the day of my lesson?', answer: 'Rain doesn’t cancel a surf lesson — you’re getting wet anyway, and surfing in warm rain in Costa Rica is a great memory. The only thing that moves a lesson is ocean conditions: if waves or currents aren’t safe for beginners, we reschedule you or refund you. The ocean decides, not the weather app.' },
  { question: 'How many lessons do I need before I can surf on my own?', answer: 'Most people ride their first waves during lesson one. After 3–5 lessons, most students can paddle into small waves and pop up without help. If you’re in Tamarindo for a week, a 3-lesson package is the sweet spot: you’ll leave actually knowing how to surf.' },
  { question: 'What’s included in a surf lesson at Outsider Surf Academy?', answer: 'Everything you need: a soft-top board matched to your size, rash guard, leash and wax, plus a certified bilingual instructor — and your lesson scheduled at the best tide of the day. You bring a swimsuit, reef-safe sunscreen and water. We also take photos of your session.' },
  { question: 'What makes Outsider different from other surf schools in Tamarindo?', answer: 'The big schools are great at moving lots of students every day. We deliberately work the opposite way: groups capped at 4, instructors who know your name, lessons timed to the tide, and direct WhatsApp contact with the team that will teach you. If you want to be a student and not a ticket number, that’s what we built.' },
]
---

<BaseLayout title={seo.title} description={seo.description} slug={seo.slug} keyfocus={seo.keyfocus} image={seo.image} synonyms={seo.synonyms} transparentNav={true}>
  <FAQSchema slot="head" items={faqs} />

  <div class="lp">

    <!-- ═══════════ HERO ═══════════ -->
    <header class="hero">
      <div class="hero-bg"></div>
      <div class="hero-inner">
        <div class="hero-content">
          <div class="hero-coords"><span class="dot"></span>Tamarindo · Guanacaste · Costa Rica</div>
          <h1>Surf School in Tamarindo, Costa Rica <span class="accent">— catch your first wave today</span></h1>
          <p class="hero-sub">Private, semi-private and group surf lessons for all ages and levels. Equipment, rash guard and a bilingual instructor included. Book in two minutes, surf today.</p>
          <div class="hero-ctas">
            <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book Your Lesson
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="#lessons" class="lp-btn lp-btn-line">View Lessons</a>
            <div class="hero-rating">
              <span class="stars">★★★★★</span>
              <span><b>Rated 5.0</b> on Google by our students</span>
            </div>
          </div>
          <div class="hero-conditions" aria-label="Today's surf conditions in Tamarindo">
            <span class="hc-live">Conditions now</span>
            <span class="hc-sep"></span>
            <span class="hc-item"><b>1.4m</b><span>Swell</span></span>
            <span class="hc-sep"></span>
            <span class="hc-item"><b>12s</b><span>Period</span></span>
            <span class="hc-sep"></span>
            <span class="hc-item"><b>Offshore</b><span>Wind 6kt</span></span>
            <span class="hc-sep"></span>
            <span class="hc-item"><b>28°C</b><span>Water</span></span>
            <span class="hc-sep"></span>
            <span class="hc-item"><b class="good">Beginner</b><span>Best for</span></span>
          </div>
        </div>
      </div>
      <!-- The wave (ocean fill) flows straight into the dark stats band -->
      <div class="hero-wave" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,80 L0,42 Q240,0 480,42 Q720,84 960,42 Q1200,0 1440,42 L1440,80 Z" fill="#06322E"/>
        </svg>
      </div>
    </header>

    <!-- ═══════════ STATS BAND ═══════════ -->
    <section class="stats" aria-label="Why surfers choose Outsider">
      <div class="lpw">
        <div class="stats-grid">
          <div class="stat reveal"><div class="stat-num">1<span>:4</span></div><div class="stat-lbl">Max students / instructor</div></div>
          <div class="stat reveal"><div class="stat-num">2<span>h</span></div><div class="stat-lbl">Sand + water lesson</div></div>
          <div class="stat reveal"><div class="stat-num">27–29<span>°C</span></div><div class="stat-lbl">Warm water all year</div></div>
          <div class="stat reveal"><div class="stat-num">100<span>%</span></div><div class="stat-lbl">Equipment included</div></div>
        </div>
      </div>
    </section>

    <!-- ═══════════ LESSONS ═══════════ -->
    <section class="lessons" id="lessons">
      <div class="lpw">
        <div class="section-head reveal">
          <span class="eyebrow center">Choose your format</span>
          <h2>Surf lessons for <em>every level</em></h2>
          <p>Never touched a surfboard, or surfed once five years ago? Perfect — that’s exactly who we teach in Tamarindo every day.</p>
        </div>
        <div class="cards">

          <div class="card reveal">
            <div class="card-top">
              <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3"/><circle cx="16" cy="9" r="2.5"/><path d="M2 21v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><path d="M16 14a4 4 0 0 1 4 4v1"/></svg></div>
              <span class="card-tier">Format 01</span>
            </div>
            <h3>Group Lesson</h3>
            <div class="card-price"><strong>$50</strong><span>/ person · 2 hours</span></div>
            <p class="card-desc">The social way to learn. Never more than 4 students per instructor — real feedback and real time in the water, nothing like the crowded lessons you’ve seen.</p>
            <ul class="card-features">
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Max 4 students per instructor</li>
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Board &amp; rash guard included</li>
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Perfect for solo travelers</li>
            </ul>
            <a href={ROUTES.GROUP} class="card-cta">Check Availability</a>
          </div>

          <div class="card featured reveal">
            <span class="card-badge">Most Popular</span>
            <div class="card-top">
              <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><path d="M2 20v-1a4.5 4.5 0 0 1 4.5-4.5h3A4.5 4.5 0 0 1 14 19v1"/><path d="M14 14.5A4.5 4.5 0 0 1 17.5 14h0A4.5 4.5 0 0 1 22 18.5V20"/></svg></div>
              <span class="card-tier">Format 02</span>
            </div>
            <h3>Semi-Private</h3>
            <div class="card-price"><strong>$65</strong><span>/ person · 2–3 people</span></div>
            <p class="card-desc">Built for couples &amp; friends. Share one instructor, keep individual corrections — at a lower price per person. The sweet spot for most visitors.</p>
            <ul class="card-features">
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> 2–3 people, dedicated instructor</li>
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Board &amp; rash guard included</li>
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Ideal for couples &amp; friends</li>
            </ul>
            <a href={ROUTES.SEMI_PRIVATE} class="card-cta">Check Availability</a>
          </div>

          <div class="card reveal">
            <div class="card-top">
              <div class="card-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/></svg></div>
              <span class="card-tier">Format 03</span>
            </div>
            <h3>Private 1-on-1</h3>
            <div class="card-price"><strong>$80</strong><span>/ person · 1-on-1</span></div>
            <p class="card-desc">One instructor, focused entirely on you. Your pace, your technique, your questions — the fastest way to learn and the most comfortable if you’re nervous.</p>
            <ul class="card-features">
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> 100% instructor attention</li>
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Board &amp; rash guard included</li>
              <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Fastest progression</li>
            </ul>
            <a href={ROUTES.PRIVATE} class="card-cta">Check Availability</a>
          </div>

        </div>
      </div>
    </section>

    <div class="horizon"></div>

    <!-- ═══════════ WHY ═══════════ -->
    <section class="why" id="why">
      <div class="lpw">
        <div class="two-col">
          <div class="img-frame reveal">
            <img src="/images/surf-school-tamarindo-beginner-lesson.jpeg" alt="Beginner surf lesson on a sandy-bottom beach with a bilingual instructor" loading="lazy" />
            <span class="img-tag"><b>Capped at 4</b> students per instructor</span>
          </div>
          <div class="prose reveal">
            <span class="eyebrow">Why Tamarindo</span>
            <h2>Warm water, sandy bottom, <em>forgiving</em> waves</h2>
            <p>The main break at Tamarindo is a classic beach break — waves rolling in over a soft sandy bottom, with no rocks and no reef. The water sits at 27–29 °C year-round, so you’re in the ocean, not surviving it.</p>
            <p>Waves break waist-to-chest high: powerful enough to actually ride, forgiving enough that falling doesn’t hurt. That rare combination is exactly why Tamarindo is one of the best places in the world to learn.</p>
            <div class="facts">
              <div class="fact"><div class="fact-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4.5V14a4 4 0 1 1-4 0V4.5a2 2 0 1 1 4 0Z"/></svg></div><p>Water 27–29 °C all year</p></div>
              <div class="fact"><div class="fact-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18c2-3 5-4 8-2s6 2 8-1"/><path d="M2 13c2-3 5-4 8-2s6 2 8-1"/></svg></div><p>Sandy bottom — no rocks, no reef</p></div>
              <div class="fact"><div class="fact-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12c3-5 6-5 9 0s6 5 9 0"/></svg></div><p>Consistent waist-to-chest waves</p></div>
              <div class="fact"><div class="fact-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg></div><p>Lessons timed to the best tide</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ HOW IT WORKS ═══════════ -->
    <section class="experience" id="how">
      <div class="lpw">
        <div class="section-head reveal">
          <span class="eyebrow center on-dark">What to expect</span>
          <h2>Your lesson, <em>step by step</em></h2>
          <p>A lot of people book without knowing what they’re walking into. Here’s exactly what happens — from the sand to your first wave.</p>
        </div>
        <div class="steps">
          <div class="step reveal">
            <div class="step-n">01</div>
            <h3>Safety &amp; beach practice</h3>
            <p>Every lesson starts on the sand: ocean safety, reading currents, posture and the pop-up — practiced dry before you touch the water. About 20–25 minutes that make everything click faster.</p>
          </div>
          <div class="step reveal">
            <div class="step-n">02</div>
            <h3>Your first waves</h3>
            <p>Your instructor stays with you the entire time in the water — whitewater first, a real push at the right moment, feedback between every wave. Most students stand up on their first or second attempt.</p>
          </div>
          <div class="step reveal">
            <div class="step-n">03</div>
            <h3>Leave with skills</h3>
            <p>By the end of two hours you’re riding waves with control and feeling the timing on your own — not just “kind of stood up once.” You’ll leave with the foundation to keep improving.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ INCLUDED ═══════════ -->
    <section class="included">
      <div class="lpw">
        <div class="section-head reveal">
          <span class="eyebrow center">No hidden extras</span>
          <h2>Everything’s included</h2>
        </div>
        <div class="inc-grid">
          <div class="inc-item reveal"><div class="inc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c6-2 12-8 18-18"/><path d="M14 4c2 0 4 2 4 4"/></svg></div><p>Soft-top board for your size</p></div>
          <div class="inc-item reveal"><div class="inc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8 8 4h8l4 4-3 2v10H7V10z"/></svg></div><p>Rash guard, leash &amp; wax</p></div>
          <div class="inc-item reveal"><div class="inc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 3 2 6 2s6-1 6-2v-5"/></svg></div><p>Bilingual instructor (EN/ES)</p></div>
          <div class="inc-item reveal"><div class="inc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 9 8 11 4.5-2 8-6 8-11V5z"/></svg></div><p>Safety briefing &amp; photos</p></div>
        </div>
      </div>
    </section>

    <!-- ═══════════ INSTRUCTORS ═══════════ -->
    <section class="instructors" id="instructors">
      <div class="lpw">
        <div class="two-col reverse">
          <div class="img-frame reveal">
            <img src="/images/surf-school-tamarindo-beach-surf-instructor-student.jpeg" alt="Certified bilingual surf instructor coaching a student in Tamarindo, Costa Rica" loading="lazy" />
            <span class="img-tag"><b>Local</b> · bilingual · certified</span>
          </div>
          <div class="prose reveal">
            <span class="eyebrow">Your instructors</span>
            <h2>Locals who surf this break <em>every day</em></h2>
            <p>Our instructors grew up surfing Guanacaste. They know every shift in the break, every tide pattern, and exactly where to position a beginner to catch the right wave at the right moment.</p>
            <p>You won’t be handed to a trainee. Every session is led by someone who teaches in English and Spanish and has put real hours in the water with students just like you.</p>
            <div class="badges">
              <span class="badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Certified instructors</span>
              <span class="badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> CPR &amp; First Aid</span>
              <span class="badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Bilingual EN / ES</span>
              <span class="badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> All ages &amp; levels</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ TESTIMONIALS ═══════════ -->
    <section class="testimonials">
      <div class="lpw">
        <div class="section-head reveal">
          <span class="eyebrow center">Student reviews</span>
          <h2>What our surfers say</h2>
        </div>
        <div class="reviews">
          <div class="review reveal">
            <div class="stars">★★★★★</div>
            <blockquote>“Never touched a board in my life. Within 90 minutes I was standing up and riding on my own. He read the ocean perfectly — knew exactly when to tell me to paddle.”</blockquote>
            <div class="reviewer"><div class="av a1">JM</div><div><div class="rev-name">Jake M.</div><div class="rev-origin">Seattle, USA</div></div></div>
          </div>
          <div class="review reveal">
            <div class="stars">★★★★★</div>
            <blockquote>“We booked the semi-private as a couple and it was the highlight of our Costa Rica trip. Small-group feel, patient instructor. We both stood up on the first session.”</blockquote>
            <div class="reviewer"><div class="av a2">SL</div><div><div class="rev-name">Sophie L.</div><div class="rev-origin">London, UK</div></div></div>
          </div>
          <div class="review reveal">
            <div class="stars">★★★★★</div>
            <blockquote>“Took my kids (8 and 11) for lessons. Calm, encouraging, very safety-conscious. As a parent, knowing they were completely safe made the whole thing perfect.”</blockquote>
            <div class="reviewer"><div class="av a3">CR</div><div><div class="rev-name">Carlos R.</div><div class="rev-origin">Toronto, Canada</div></div></div>
          </div>
        </div>
        <div class="reviews-cta reveal">
          <!-- TODO: point to your Google Business reviews URL -->
          <a href="#" class="lp-btn lp-btn-ghost" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 11v2.8h4.6c-.2 1.2-1.5 3.5-4.6 3.5a5.3 5.3 0 0 1 0-10.6c1.5 0 2.5.6 3.1 1.2l2.1-2C16 4.6 14.2 4 12 4a8 8 0 1 0 0 16c4.6 0 7.7-3.2 7.7-7.8 0-.5 0-.9-.1-1.2H12Z"/></svg>
            Read All Reviews on Google
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════ RENTALS BANNER ═══════════ -->
    <section class="rentals">
      <div class="lpw">
        <div class="rentals-card reveal">
          <div class="rentals-text">
            <h2>Surfboard Rentals in Tamarindo</h2>
            <p>Already know how to surf? We rent quality boards — softtops, funboards and shortboards — by the hour, day or week, right on Tamarindo Beach.</p>
          </div>
          <a href={ROUTES.RENTALS} class="lp-btn lp-btn-white">See Boards &amp; Prices</a>
        </div>
      </div>
    </section>

    <!-- ═══════════ FAQ ═══════════ -->
    <section class="faq" id="faq">
      <div class="lpw">
        <div class="section-head reveal">
          <span class="eyebrow center">Before you book</span>
          <h2>Frequently asked questions</h2>
          <p>Everything you need to know about surf lessons in Tamarindo — answered honestly.</p>
        </div>
        <div class="faq-wrap">
          {faqs.map(f => (
            <div class="faq-item reveal">
              <button class="faq-q">{f.question}<span class="faq-ico">+</span></button>
              <div class="faq-a"><div class="faq-inner"><p>{f.answer}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ FINAL CTA ═══════════ -->
    <section class="cta" id="book">
      <div class="lpw">
        <div class="cta-content reveal">
          <span class="eyebrow center on-dark">Ready to paddle out?</span>
          <h2>Book your lesson in <em>Tamarindo</em></h2>
          <p>The waves are here, the boards are waxed. The only thing missing is you. Book online in two minutes, or message us on WhatsApp.</p>
          <div class="cta-btns">
            <a href={ROUTES.BOOK} class="lp-btn lp-btn-sun">Book a Lesson Now
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href={ROUTES.CONTACT} class="lp-btn lp-btn-line">
